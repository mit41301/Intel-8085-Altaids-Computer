     275/     11A :                     ;
     276/     11A :                     ;*************************************************************
     277/     11A :                     ;
     278/     11A :                     ; *** MAIN ***
     279/     11A :                     ;
     280/     11A :                     ; THIS IS THE MAIN LOOP THAT COLLECTS THE TINY BASIC PROGRAM
     281/     11A :                     ; AND STORES IT IN THE MEMORY.
     282/     11A :                     ;
     283/     11A :                     ; AT START, IT PRINTS OUT "(CR)OK(CR)", AND INITIALIZES THE
     284/     11A :                     ; STACK AND SOME OTHER INTERNAL VARIABLES.  THEN IT PROMPTS
     285/     11A :                     ; ">" AND READS A LINE.  IF THE LINE STARTS WITH A NON-ZERO
     286/     11A :                     ; NUMBER, THIS NUMBER IS THE LINE NUMBER.  THE LINE NUMBER
     287/     11A :                     ; (IN 16 BIT BINARY) AND THE REST OF THE LINE (INCLUDING CR)
     288/     11A :                     ; IS STORED IN THE MEMORY.  IF A LINE WITH THE SAME LINE
     289/     11A :                     ; NUMBER IS ALREADY THERE, IT IS REPLACED BY THE NEW ONE.  IF
     290/     11A :                     ; THE REST OF THE LINE CONSISTS OF A CR ONLY, IT IS NOT STORED
     291/     11A :                     ; AND ANY EXISTING LINE WITH THE SAME LINE NUMBER IS DELETED.
     292/     11A :                     ;
     293/     11A :                     ; AFTER A LINE IS INSERTED, REPLACED, OR DELETED, THE PROGRAM
     294/     11A :                     ; LOOPS BACK AND ASKS FOR ANOTHER LINE.  THIS LOOP WILL BE
     295/     11A :                     ; TERMINATED WHEN IT READS A LINE WITH ZERO OR NO LINE
     296/     11A :                     ; NUMBER; AND CONTROL IS TRANSFERED TO "DIRECT".
     297/     11A :                     ;
     298/     11A :                     ; TINY BASIC PROGRAM SAVE AREA STARTS AT THE MEMORY LOCATION
     299/     11A :                     ; LABELED "TXTBGN" AND ENDS AT "TXTEND".  WE ALWAYS FILL THIS
     300/     11A :                     ; AREA STARTING AT "TXTBGN", THE UNFILLED PORTION IS POINTED
     301/     11A :                     ; BY THE CONTENT OF A MEMORY LOCATION LABELED "TXTUNF".
     302/     11A :                     ;
     303/     11A :                     ; THE MEMORY LOCATION "CURRNT" POINTS TO THE LINE NUMBER
     304/     11A :                     ; THAT IS CURRENTLY BEING INTERPRETED.  WHILE WE ARE IN
     305/     11A :                     ; THIS LOOP OR WHILE WE ARE INTERPRETING A DIRECT COMMAND
     306/     11A :                     ; (SEE NEXT SECTION). "CURRNT" SHOULD POINT TO A 0.
     307/     11A :                     ;
     308/     11A : 21 21 01            ST1:    LXI  H,ST2+1            ;PTR TO MEM.LOC = 0
     309/     11D : 22 06 80                    SHLD CURRNT             ;CURRENT->LINE # = 0
     310/     120 : 21 00 00            ST2:    LXI  H,0
     311/     123 : 22 0E 80                    SHLD LOPVAR
     312/     126 : 22 08 80                    SHLD STKGOS
     313/     129 : C9                          RET
     314/     12A :                     ;
     315/     12A : 97                  CTRLC:  SUB  A                  ;FOR CTRL-C WE ALSO
     316/     12B : D3 30                       OUT  SELECT             ;RESET THE SELECT LINES
     317/     12D : 31 00 C0            RSTART: LXI  SP,STACK           ;HERE WE COME AFTER
     318/     130 : CD 1A 01                    CALL ST1                ;EXEC FINISH OR CTRL-C
     319/     133 : 3E 15               ST0:    MVI  A,UENABL           ;MAKE SURE BEEP IS OFF
     320/     135 : D3 11                       OUT  UARTC              ;WRITE IT TO PORT
     321/     137 : CD 0E 00                    CALL CRLF               ;AND JUMP TO HERE
     322/     13A : 11 03 01                    LXI  D,OK               ;DE->STRING
     323/     13D : 97                          SUB  A                  ;A=0
     324/     13E : CD 21 09                    CALL PRTSTG             ;PRINT STRING UNTIL CR
     325/     141 : 3E 3E               ST3:    MVI  A,'>'              ;PROMPT '>' AND
     326/     143 : CD 14 08                    CALL GETLN              ;READ A LINE
     327/     146 : D5                  GLNRTN: PUSH D                  ;DE->END OF LINE
     328/     147 : 11 36 BF                    LXI  D,BUFFER           ;DE->BEGINNING OF LINE
     329/     14A : CD 8C 00                    CALL TSTNUM             ;TEST IF IT IS A NUMBER
     330/     14D : EF                          RST  5
     331/     14E : 7C                          MOV  A,H                ;HL=VALUE OF THE # OR
     332/     14F : B5                          ORA  L                  ;0 IF NO # WAS FOUND
     333/     150 : C1                          POP  B                  ;BC->END OF LINE
     334/     151 : CA 17 0C                    JZ   DIRECT
     335/     154 : 1B                          DCX  D                  ;BACKUP DE AND SAVE
     336/     155 : 7C                          MOV  A,H                ;VALUE OF LINE # THERE
     337/     156 : 12                          STAX D
     338/     157 : 1B                          DCX  D
     339/     158 : 7D                          MOV  A,L
     340/     159 : 12                          STAX D
     341/     15A : C5                          PUSH B                  ;BC,DE->BEGIN, END
     342/     15B : D5                          PUSH D
     343/     15C : 79                          MOV  A,C
     344/     15D : 93                          SUB  E
     345/     15E : F5                          PUSH PSW                ;A=# OF BYTES IN LINE
     346/     15F : CD F9 08                    CALL FNDLN              ;FIND THIS LINE IN SAVE
     347/     162 : D5                          PUSH D                  ;AREA, DE->SAVE AREA
     348/     163 : C2 76 01                    JNZ  ST4                ;NZ:NOT FOUND, INSERT
     349/     166 : D5                          PUSH D                  ;Z:FOUND, DELETE IT
     350/     167 : CD 15 09                    CALL FNDNXT             ;FIND NEXT LINE
     351/     16A :                                                     ;DE->NEXT LINE
     352/     16A : C1                          POP  B                  ;BC->LINE TO BE DELETED
     353/     16B : 2A 1A 80                    LHLD TXTUNF             ;HL->UNFILLED SAVE AREA
     354/     16E : CD F1 09                    CALL MVUP               ;MOVE UP TO DELETE
     355/     171 : 60                          MOV  H,B                ;TXTUNF->UNFILLED AREA
     356/     172 : 69                          MOV  L,C
     357/     173 : 22 1A 80                    SHLD TXTUNF             ;UPDATE
     358/     176 : C1                  ST4:    POP  B                  ;GET READY TO INSERT
     359/     177 : 2A 1A 80                    LHLD TXTUNF             ;BUT FIRST CHECK IF
     360/     17A : F1                          POP  PSW                ;THE LENGTH OF NEW LINE
     361/     17B : E5                          PUSH H                  ;IS 3 (LINE # AND CR)
     362/     17C : FE 03                       CPI  3                  ;THEN DO NOT INSERT
     363/     17E : CA 2D 01                    JZ   RSTART             ;MUST CLEAR THE STACK
     364/     181 : 85                          ADD  L                  ;COMPUTE NEW TXTUNF
     365/     182 : 6F                          MOV  L,A
     366/     183 : 3E 00                       MVI  A,0
     367/     185 : 8C                          ADC  H
     368/     186 : 67                          MOV  H,A                ;HL->NEW UNFILLED AREA
     369/     187 : 11 00 BF                    LXI  D,TXTEND           ;CHECK TO SEE IF THERE
     370/     18A : E7                          RST  4                  ;IS ENOUGH SPACE
     371/     18B : D4 0D 08                    CNC  QSORRY             ;SORRY, NO ROOM FOR IT
     372/     18E : 22 1A 80                    SHLD TXTUNF             ;OK, UPDATE TXTUNF
     373/     191 : D1                          POP  D                  ;DE->OLD UNFILLED AREA
     374/     192 : CD FA 09                    CALL MVDOWN
     375/     195 : D1                          POP  D                  ;DE->BEGIN, HL->END
     376/     196 : E1                          POP  H
     377/     197 : CD F1 09                    CALL MVUP               ;MOVE NEW LINE TO SAVE
     378/     19A : C3 41 01                    JMP  ST3                ;AREA
     379/     19D :                     ;
     380/     19D :                     ;*************************************************************
     381/     19D :                     ;
     382/     19D :                     ; WHAT FOLLOWS IS THE CODE TO EXECUTE DIRECT AND STATEMENT
     383/     19D :                     ; COMMANDS.  CONTROL IS TRANSFERED TO THESE POINTS VIA THE
     384/     19D :                     ; COMMAND TABLE LOOKUP CODE OF 'DIRECT' AND 'EXEC' IN LAST
     385/     19D :                     ; SECTION.  AFTER THE COMMAND IS EXECUTED, CONTROL IS
     386/     19D :                     ; TRANSFERED TO OTHERS SECTIONS AS FOLLOWS:
     387/     19D :                     ;
     388/     19D :                     ; FOR 'LIST', 'NEW', AND 'STOP': GO BACK TO 'RSTART'
     389/     19D :                     ; FOR 'RUN': GO EXECUTE THE FIRST STORED LINE IF ANY, ELSE
     390/     19D :                     ; GO BACK TO 'RSTART'.
     391/     19D :                     ; FOR 'GOTO' AND 'GOSUB': GO EXECUTE THE TARGET LINE.
     392/     19D :                     ; FOR 'RETURN' AND 'NEXT': GO BACK TO SAVED RETURN LINE.
     393/     19D :                     ; FOR ALL OTHERS: IF 'CURRENT' -> 0, GO TO 'RSTART', ELSE
     394/     19D :                     ; GO EXECUTE NEXT COMMAND.  (THIS IS DONE IN 'FINISH'.)
     395/     19D :                     ;*************************************************************
     396/     19D :                     ;
     397/     19D :                     ; *** NEW *** STOP *** RUN (& FRIENDS) *** & GOTO ***
     398/     19D :                     ;
     399/     19D :                     ; 'NEW(CR)' SETS 'TXTUNF' TO POINT TO 'TXTBGN'
     400/     19D :                     ;
     401/     19D :                     ; 'STOP(CR)' GOES BACK TO 'RSTART'
     402/     19D :                     ;
     403/     19D :                     ; 'RUN(CR)' FINDS THE FIRST STORED LINE, STORE ITS ADDRESS (IN
     404/     19D :                     ; 'CURRENT'), AND START EXECUTE IT.  NOTE THAT ONLY THOSE
     405/     19D :                     ; COMMANDS IN TAB2 ARE LEGAL FOR STORED PROGRAM.
     406/     19D :                     ;
     407/     19D :                     ; THERE ARE 3 MORE ENTRIES IN 'RUN':
     408/     19D :                     ; 'RUNNXL' FINDS NEXT LINE, STORES ITS ADDR. AND EXECUTES IT.
     409/     19D :                     ; 'RUNTSL' STORES THE ADDRESS OF THIS LINE AND EXECUTES IT.
     410/     19D :                     ; 'RUNSML' CONTINUES THE EXECUTION ON SAME LINE.
     411/     19D :                     ;
     412/     19D :                     ; 'GOTO EXPR(CR)' EVALUATES THE EXPRESSION, FIND THE TARGET
     413/     19D :                     ; LINE, AND JUMP TO 'RUNTSL' TO DO IT.
     414/     19D :                     ;
     415/     19D : CD B6 07            NEW:    CALL ENDCHK             ;*** NEW(CR) ***
     416/     1A0 : 21 1C 80                    LXI  H,TXTBGN
     417/     1A3 : 22 1A 80                    SHLD TXTUNF
     418/     1A6 :                     ;
     419/     1A6 : CD B6 07            STOP:   CALL ENDCHK             ;*** STOP(CR) ***
     420/     1A9 : C3 2D 01                    JMP  RSTART
     421/     1AC :                     ;
     422/     1AC : CD B6 07            RUN:    CALL ENDCHK             ;*** RUN(CR) ***
     423/     1AF : AF                          XRA  A                  ;RESET THE
     424/     1B0 : 32 00 80                    STA  RCVCHR             ;RCVD CHAR VAR
     425/     1B3 : 11 1C 80                    LXI  D,TXTBGN           ;FIRST SAVED LINE
     426/     1B6 :                     ;
     427/     1B6 : 21 00 00            RUNNXL: LXI  H,0                ;*** RUNNXL ***
     428/     1B9 : CD 01 09                    CALL FNDLP              ;FIND WHATEVER LINE #
     429/     1BC : DA 2D 01                    JC   RSTART             ;C:PASSED TXTUNF, QUIT
     430/     1BF :                     ;
     431/     1BF : EB                  RUNTSL: XCHG                    ;*** RUNTSL ***
     432/     1C0 : 22 06 80                    SHLD CURRNT             ;SET 'CURRENT'->LINE #
     433/     1C3 : EB                          XCHG
     434/     1C4 : 13                          INX  D                  ;BUMP PASS LINE #
     435/     1C5 : 13                          INX  D
     436/     1C6 :                     ;
     437/     1C6 : CD E6 0A            RUNSML: CALL CHKIO              ;*** RUNSML ***
     438/     1C9 : CA CF 01                    JZ   RUNS1              ;NO CHARACTER, JUMP
     439/     1CC : 32 00 80                    STA  RCVCHR             ;ELSE STORE IT
     440/     1CF : 21 1C 0B            RUNS1:  LXI  H,TAB2-1           ;FIND COMMAND IN TAB2
     441/     1D2 : C3 1A 0C                    JMP  EXEC               ;AND EXECUTE IT
     442/     1D5 :                     ;
     443/     1D5 : DF                  GOTO:   RST  3                  ;*** GOTO EXPR ***
     444/     1D6 : D5                          PUSH D                  ;SAVE FOR ERROR ROUTINE
     445/     1D7 : CD B6 07                    CALL ENDCHK             ;MUST FIND A CR
     446/     1DA : CD F9 08                    CALL FNDLN              ;FIND THE TARGET LINE
     447/     1DD : C4 F9 00                    CNZ  AHOW               ;NO SUCH LINE #
     448/     1E0 : F1                          POP  PSW                ;CLEAR THE PUSH DE
     449/     1E1 : C3 BF 01                    JMP  RUNTSL             ;GO DO IT
     450/     1E4 :                     ;
     451/     1E4 : 2A 1A 80            SAVE:   LHLD TXTUNF             ;*** SAVE PGM ***
     452/     1E7 : 01 1C 80                    LXI  B,TXTBGN           ;CALC ACTUAL LENGTH
     453/     1EA : (MACRO)                     DSUB                    ;USING TXTUNF-TXTBGN
     453/     1EA : 08                          DB    08H
     454/     1EB : 11 02 00                    LXI  D,2                ;HL IS NOW LENGTH OF PGM
     455/     1EE : 19                          DAD  D                  ;ADD TWO FOR LEN ITSELF
     456/     1EF : EB                          XCHG                    ;PUT IT IN DE
     457/     1F0 : 01 02 00                    LXI  B,EESTRT+2         ;BC IS START IN EEPROM
     458/     1F3 : 21 1A 80                    LXI  H,TXTUNF           ;START SAVING AT LENGTH
     459/     1F6 : CD EE 0C                    CALL EEWR               ;WRITE TO EEPROM
     460/     1F9 : C3 2D 01                    JMP  RSTART
     461/     1FC :                     ;
     462/     1FC : CD 02 02            LOAD:   CALL LD0                ;*** LOAD PGM ***
     463/     1FF : C3 2D 01                    JMP  RSTART
     464/     202 :                     ;
     465/     202 : 01 02 00            LD0:    LXI  B,EESTRT+2         ;START ADR IN EEPROM
     466/     205 : 11 02 00                    LXI  D,2                ;FIND THE LEN IN EEPROM
     467/     208 : 21 1A 80                    LXI  H,TXTUNF           ;STORE TEMPORARY
     468/     20B : CD 92 0C                    CALL EERD               ;READ EEPROM
     469/     20E : 2A 1A 80                    LHLD TXTUNF             ;GET THE LENGTH VARIABLE
     470/     211 : 01 1C 80                    LXI  B,TXTBGN           ;CALC ACTUAL LENGTH
     471/     214 : (MACRO)                     DSUB                    ;USING TXTUNF-TXTBGN
     471/     214 : 08                          DB    08H
     472/     215 : EB                          XCHG                    ;CHECK THAT LENGTH IS
     473/     216 : 21 E4 3E                    LXI  H,VARBGN-TXTBGN    ;LESS THAN AVAILABLE
     474/     219 : E7                          RST  4                  ;COMPARE HL - DE
     475/     21A : D2 26 02                    JNC  LD1                ;NO CARRY = WILL FIT
     476/     21D : 21 1C 80                    LXI  H,TXTBGN           ;ELSE REINIT TEXT PTR
     477/     220 : 22 1A 80                    SHLD TXTUNF             ;BECAUSE READ LENGTH
     478/     223 : CD 0D 08                    CALL QSORRY             ;WILL NOT FIT RAM
     479/     226 : 01 04 00            LD1:    LXI  B,EESTRT+4         ;OK READ EERPOM
     480/     229 : 21 1C 80                    LXI  H,TXTBGN           ;TO TEXT AREA
     481/     22C : CD 92 0C                    CALL EERD
     482/     22F : C9                          RET
     483/     230 :                     ;
     484/     230 : D5                  EDIT:   PUSH D                  ;SAVE PTR FOR THE ASCII NUM
     485/     231 : CD 8C 00                    CALL TSTNUM             ;LOOK FOR A LINE NUMBER
     486/     234 : 7D                          MOV  A,L                ;RETURN ZERO (HL) IF NO NUM
     487/     235 : B4                          ORA  H                  ;CHECK FOR ABSENCE OF NUM
     488/     236 : CC F9 00                    CZ   AHOW               ;THEN ASK HOW?
     489/     239 : CD B6 07                    CALL ENDCHK             ;MAKE SURE NO GARBAGE
     490/     23C : CD F9 08                    CALL FNDLN              ;RETURN LINE PTR IN (DE)
     491/     23F : DA 2D 01                    JC   RSTART             ;OR, NO SUCH LINE
     492/     242 : E1                          POP  H                  ;GET PTR TO ASCII BACK
     493/     243 : EB                          XCHG                    ;SWAP WITH LINE PTR
     494/     244 : EF                          RST  5                  ;SKIP BLANKS TO NUMBER
     495/     245 : 01 36 BF                    LXI  B,BUFFER           ;START FILL INPUT BUFFER
     496/     248 : 1A                  ED1:    LDAX D                  ;PULL ASCII NUMBER CHARS
     497/     249 : FE 0D                       CPI  CR                 ;UNTIL 'CR' FOUND
     498/     24B : CA 54 02                    JZ   ED2
     499/     24E : 02                          STAX B                  ;MOVE NUMBER TO BUF START
     500/     24F : 13                          INX  D                  ;BUMP POINTERS
     501/     250 : 03                          INX  B                  ;AND CONTINUE
     502/     251 : C3 48 02                    JMP  ED1
     503/     254 : 3E 20               ED2:    MVI  A,' '              ;INSERT A SPACE AFTER
     504/     256 : 02                          STAX B                  ;THE LINE NUMBER
     505/     257 : 23                          INX  H                  ;BUMP PAST THE INTEGER
     506/     258 : 23                  ED3:    INX  H                  ;LINE NUMBER IN MEMORY
     507/     259 : 03                          INX  B
     508/     25A : 7E                          MOV  A,M                ;PULL REST OF LINE
     509/     25B : 02                          STAX B                  ;COPY TO INPUT BUF
     510/     25C : FE 0D                       CPI  CR                 ;UNTIL AND INCLUDING 'CR'
     511/     25E : C2 58 02                    JNZ  ED3
     512/     261 : 11 36 BF                    LXI  D,BUFFER           ;BEGIN AT BUFFER START
     513/     264 : 3E 0D                       MVI  A,CR               ;STOP WHEN 'CR' FOUND
     514/     266 : CD 21 09                    CALL PRTSTG             ;PRINT BUFFER
     515/     269 : 1B                          DCX  D                  ;BACK UP, POINT TO CR
     516/     26A : 21 46 01                    LXI  H,GLNRTN           ;FIND RETURN ADDR
     517/     26D : E5                          PUSH H                  ;AND PUT IT ON STACK
     518/     26E : C3 18 08                    JMP  EDITLN             ;GOTO GETLINE FOR EDIT
     519/     271 :                     ;
     520/     271 : 21 94 0D            HELP:   LXI  H,MSGHLP           ;*** SHORT HELP ***
     521/     274 : C3 7A 02                    JMP  MA1                ;PRINT THE TEXT UNTIL NULL
     522/     277 :                     ;
     523/     277 : 21 0A 0F            MAN:    LXI  H,MSGMAN           ;*** MANUAL ***
     524/     27A : CD C4 0A            MA1:    CALL PSTR               ;PRINT THE TEXT UNTIL NULL
     525/     27D : C3 2D 01                    JMP  RSTART
     526/     280 :                     ;
     527/     280 :                     ;*************************************************************
     528/     280 :                     ;
     529/     280 :                     ; *** LIST *** & PRINT *** ETC. ***
     530/     280 :                     ;
     531/     280 :                     ; LIST HAS TWO FORMS:
     532/     280 :                     ; 'LIST(CR)' LISTS ALL SAVED LINES
     533/     280 :                     ; 'LIST #(CR)' START LIST AT THIS LINE #
     534/     280 :                     ; YOU CAN STOP THE LISTING BY CONTROL C KEY
     535/     280 :                     ;
     536/     280 :                     ; PRINT COMMAND IS 'PRINT ....:' OR 'PRINT ....(CR)'
     537/     280 :                     ; WHERE '....' IS A LIST OF EXPRESIONS, FORMATS, BACK-
     538/     280 :                     ; ARROWS, AND STRINGS.  THESE ITEMS ARE SEPERATED BY COMMAS.
     539/     280 :                     ;
     540/     280 :                     ; A FORMAT IS A POUND SIGN FOLLOWED BY A NUMBER.  IT CONTROLS
     541/     280 :                     ; THE NUMBER OF SPACES THE VALUE OF A EXPRESION IS GOING TO
     542/     280 :                     ; BE PRINTED.  IT STAYS EFFECTIVE FOR THE REST OF THE PRINT
     543/     280 :                     ; COMMAND UNLESS CHANGED BY ANOTHER FORMAT.  IF NO FORMAT IS
     544/     280 :                     ; SPECIFIED, 6 POSITIONS WILL BE USED.
     545/     280 :                     ;
     546/     280 :                     ; A STRING IS QUOTED IN A PAIR OF SINGLE QUOTES OR A PAIR OF
     547/     280 :                     ; DOUBLE QUOTES.
     548/     280 :                     ;
     549/     280 :                     ; A BACK-SLASH MEANS PRINT THE ASCII CHAR OF FOLLOWING NUMBER.
     550/     280 :                     ;
     551/     280 :                     ; A (CRLF) IS GENERATED AFTER THE ENTIRE LIST HAS BEEN
     552/     280 :                     ; PRINTED OR IF THE LIST IS A NULL LIST.  HOWEVER IF THE LIST
     553/     280 :                     ; ENDED WITH A COMMA, NO (CRLF) IS GENERATED.
     554/     280 :                     ;
     555/     280 : CD 8C 00            LIST:   CALL TSTNUM             ;TEST IF THERE IS A #
     556/     283 : CD B6 07                    CALL ENDCHK             ;IF NO # WE GET A 0
     557/     286 : CD F9 08                    CALL FNDLN              ;FIND THIS OR NEXT LINE
     558/     289 : DA 2D 01            LS1:    JC   RSTART             ;C:PASSED TXTUNF
     559/     28C : CD AB 09                    CALL PRTLN              ;PRINT THE LINE
     560/     28F : CD E6 0A                    CALL CHKIO              ;STOP IF HIT CONTROL-C
     561/     292 : CD 01 09                    CALL FNDLP              ;FIND NEXT LINE
     562/     295 : C3 89 02                    JMP  LS1                ;AND LOOP BACK
     563/     298 :                     ;
     564/     298 : 0E 06               PRINT:  MVI  C,6                ;C = # OF SPACES
     565/     29A : CF                          RST  1                  ;IF NULL LIST & ":"
     566/     29B : 3A                          DB   ':'
     567/     29C : 06                          DB   PR2-$-1
     568/     29D : CD 0E 00                    CALL CRLF               ;GIVE CR-LF AND
     569/     2A0 : C3 C6 01                    JMP  RUNSML             ;CONTINUE SAME LINE
     570/     2A3 : CF                  PR2:    RST  1                  ;IF NULL LIST (CR)
     571/     2A4 : 0D                          DB   CR
     572/     2A5 : 06                          DB   PR0-$-1
     573/     2A6 : CD 0E 00                    CALL CRLF               ;ALSO GIVE CR-LF AND
     574/     2A9 : C3 B6 01                    JMP  RUNNXL             ;GO TO NEXT LINE
     575/     2AC : CF                  PR0:    RST  1                  ;ELSE IS IT FORMAT?
     576/     2AD : 23                          DB   '#'
     577/     2AE : 05                          DB   PR4-$-1
     578/     2AF : DF                          RST  3                  ;YES, EVALUATE EXPR.
     579/     2B0 : 4D                          MOV  C,L                ;AND SAVE IT IN C
     580/     2B1 : C3 C5 02                    JMP  PR3                ;LOOK FOR MORE TO PRINT
     581/     2B4 : CF                  PR4:    RST  1                  ;ELSE IS IT HEXADECIMAL?
     582/     2B5 : 24                          DB   '$'
     583/     2B6 : 08                          DB   PR1-$-1
     584/     2B7 : DF                          RST  3                  ;YES, EVALUATE EXPR.
     585/     2B8 : 7D                          MOV  A,L                ;HEXADECIMAL FORMAT
     586/     2B9 : 2F                          CMA                     ;CHANGE SIGN
     587/     2BA : 3C                          INR  A                  ;AS A FLAG
     588/     2BB : 4F                          MOV  C,A
     589/     2BC : C3 C5 02                    JMP  PR3                ;LOOK FOR MORE TO PRINT
     590/     2BF : CD 2D 09            PR1:    CALL QTSTG              ;OR IS IT A STRING?
     591/     2C2 : C3 D2 02                    JMP  PR8                ;IF NOT, MUST BE EXPR.
     592/     2C5 : CF                  PR3:    RST  1                  ;IF ",", GO FIND NEXT
     593/     2C6 : 2C                          DB   ','
     594/     2C7 : 06                          DB   PR6-$-1
     595/     2C8 : CD A7 07                    CALL FIN                ;IN THE LIST.
     596/     2CB : C3 AC 02                    JMP  PR0                ;LIST CONTINUES
     597/     2CE : CD 0E 00            PR6:    CALL CRLF               ;LIST ENDS
     598/     2D1 : F7                          RST  6
     599/     2D2 : DF                  PR8:    RST  3                  ;EVALUATE THE EXPR
     600/     2D3 : C5                          PUSH B
     601/     2D4 : CD 66 09                    CALL PRTNUM             ;PRINT THE VALUE
     602/     2D7 : C1                          POP  B
     603/     2D8 : C3 C5 02                    JMP  PR3                ;MORE TO PRINT?
     604/     2DB :                     ;
     605/     2DB : FF                  PUTC:   RST  7                  ;*** PUTC(EXPR) ***
     606/     2DC : 7C                          MOV  A,H
     607/     2DD : B7                          ORA  A                  ;CHECK HL < 256
     608/     2DE : C4 FC 00                    CNZ  QHOW               ;ELSE CAN'T PRINT CHAR
     609/     2E1 : DB 11               PC1:    IN   UARTC              ;COME HERE TO DO OUTPUT
     610/     2E3 : E6 01                       ANI  1H                 ;STATUS BIT
     611/     2E5 : CA E1 02                    JZ   PC1                ;NOT READY, WAIT
     612/     2E8 : 7D                          MOV  A,L                ;READY, GET CHAR
     613/     2E9 : D3 10                       OUT  UARTD              ;AND SEND IT OUT
     614/     2EB : F7                          RST  6
     615/     2EC :                     ;
     616/     2EC : FF                  WAIT:   RST  7                  ;*** WAIT(EXPR) ***
     617/     2ED : C3 F5 02                    JMP  BP0                ;SAME AS BEEP BUT NO SOUND
     618/     2F0 :                     ;
     619/     2F0 : FF                  BEEP:   RST  7                  ;*** BEEP(EXPR) ***
     620/     2F1 : 3E 35                       MVI  A,UENABL+URTS      ;BITPATTERN FOR BEEP ON
     621/     2F3 : D3 11                       OUT  UARTC              ;WRITE IT TO PORT
     622/     2F5 : EB                  BP0:    XCHG                    ;ARG TO DE AND TXPTR TO HL
     623/     2F6 : E5                          PUSH H                  ;SAVE TXTPTR
     624/     2F7 : CD F7 06                    CALL TCNT               ;GET A START TIMESTAMP
     625/     2FA : 44                          MOV  B,H                ;TRANSFER START
     626/     2FB : 4D                          MOV  C,L                ;TIMESTAMP TO BC
     627/     2FC : CD E6 0A            BP1:    CALL CHKIO              ;ACCEPT CTRL-C TO QUIT
     628/     2FF : CA 05 03                    JZ   BP2                ;JUMP IF NO CHAR RCVD
     629/     302 : 32 00 80                    STA  RCVCHR             ;ELSE STORE IT FOR GETC
     630/     305 : CD F7 06            BP2:    CALL TCNT               ;GET NEW TIMESTAMP
     631/     308 : (MACRO)                     DSUB                    ;SUBTRACT ORIG STAMP IN BC
     631/     308 : 08                          DB    08H
     632/     309 : E7                          RST  4                  ;CMPR WITH ARGUMENT IN DE
     633/     30A : DA FC 02                    JC   BP1                ;CARRY LESS THAN ARGUMENT
     634/     30D : 3E 15                       MVI  A,UENABL           ;BITPATTERN FOR BEEP OFF
     635/     30F : D3 11                       OUT  UARTC              ;WRITE IT TO PORT
     636/     311 : D1                          POP  D                  ;RESTORE TXTPTR
     637/     312 : F7                          RST  6
     638/     313 :                     ;
     639/     313 : FF                  XTAL:   RST  7                  ;*** XTAL(EXPR) ***
     640/     314 : D5                          PUSH D                  ;USE DE TO CHECK MAX AND MIN
     641/     315 : 11 CE 4C                    LXI  D,19662            ;DOUBLE XTAL OF 8085-2 CHIP
     642/     318 : E7                          RST  4                  ;COMPARE HL - DE
     643/     319 : D4 F9 00                    CNC  AHOW               ;NUMBER TOO LARGE
     644/     31C : 11 00 06                    LXI  D,1536             ;ONE 4TH OF NOMINAL XTAL
     645/     31F : E7                          RST  4                  ;COMPARE AGAIN
     646/     320 : DC F9 00                    CC   AHOW               ;NUMBER TOO SMALL
     647/     323 : D1                          POP  D                  ;RESTORE TXT PTR
     648/     324 : CD 67 03                    CALL SETXTL             ;USE DEDICATED SUB ROUTINE
     649/     327 : F7                          RST  6
     650/     328 :                     ;
     651/     328 : AF                  SIGNED: XRA  A                  ;SET SIGNED OPERATION
     652/     329 : 32 03 80                    STA  USIGNF
     653/     32C : F7                          RST  6
     654/     32D :                     ;
     655/     32D : 3E 01               UNSIGN: MVI  A,1                ;SET UNSIGNED OPERATION
     656/     32F : 32 03 80                    STA  USIGNF
     657/     332 : F7                          RST  6
     658/     333 :                     ;
     659/     333 : FF                  POUT:   RST  7                  ;GET FIRST ARGUMENT (ADDR)
     660/     334 : 7C                          MOV  A,H                ;HI BYTE OF ARGUMENT
     661/     335 : B7                          ORA  A                  ;MUST BE ZERO
     662/     336 : C4 FC 00                    CNZ  QHOW               ;ELSE CAN'T CONTINUTE
     663/     339 : E5                          PUSH H                  ;SAVE IT
     664/     33A : CD BD 07                    CALL SKPCOM             ;COMMA MAY SEPARATE ARGS
     665/     33D : FF                          RST  7                  ;GET NEXT ARGUMENT (VALUE)
     666/     33E : E3                          XTHL                    ;SWAP VAL TO STK, ADDR TO HL
     667/     33F : 7D                          MOV  A,L                ;LOW BYTE IS THE IO ADDR
     668/     340 : B7                          ORA  A                  ;IS IT ADDR 0? (8155 CMDREG)
     669/     341 : 2A 1A 80                    LHLD TXTUNF             ;POINT AT MEM.LOC AFTER PGM
     670/     344 : 36 D3                       MVI  M,0D3H             ;PLACE THE "OUT" INSTRUCTION
     671/     346 : 23                          INX  H                  ;NEXT LOCATION
     672/     347 : 77                          MOV  M,A                ;PLACE THE OUT PORT NUMBER
     673/     348 : 23                          INX  H                  ;NEXT LOCATION
     674/     349 : 36 C9                       MVI  M,0C9H             ;PLACE THE "RET" INSTRUCTION
     675/     34B : E1                          POP  H                  ;POP BACK THE VALUE ARGUMENT
     676/     34C : 7D                          MOV  A,L                ;OUT INSTR.ONLY USE LOW BYTE
     677/     34D : C2 53 03                    JNZ  POU1               ;JUMP/SKIP SAVE IF NOT ZERO
     678/     350 : 32 02 80                    STA  PCMCPY             ;SAVE CTRLBYTE IN SHADOW REG
     679/     353 : CD ED 06            POU1:   CALL RAMEXC             ;CALL SUBROUTINE IN RAM
     680/     356 : F7                          RST  6
     681/     357 :                     ;
     682/     357 : FF                  SOD:    RST  7                  ;GET ARGUMENT (DATA)
     683/     358 : 7D                          MOV  A,L                ;GET LO BYTE
     684/     359 : CD 3C 0C                    CALL SDOUT              ;AND SEND IT
     685/     35C : F7                          RST  6
     686/     35D :                     ;
     687/     35D : FF                  POKE:   RST  7                  ;GET FIRST ARGUMENT (ADDR)
     688/     35E : E5                          PUSH H                  ;SAVE IT
     689/     35F : CD BD 07                    CALL SKPCOM             ;COMMA MAY SEPARATE ARGS
     690/     362 : FF                          RST  7                  ;GET NEXT ARGUMENT (VALUE)
     691/     363 : 7D                          MOV  A,L                ;VALUE LOW BYTE TO ACC
     692/     364 : E1                          POP  H                  ;RESTORE ADDRESS
     693/     365 : 77                          MOV  M,A                ;COPY TO MEM LOC.(HL)
     694/     366 : F7                          RST  6
     695/     367 :                     ;
     696/     367 : (MACRO)             SETXTL: ARHL                    ;DIV BY 2 TO GET TIMER COUNT
     696/     367 : 10                          DB    10H
     697/     368 : 7D                          MOV  A,L                ;LOW BYTE OF COUNT
     698/     369 : D3 04                       OUT  PTIML              ;SEND TO TIMER LOW REGISTER
     699/     36B : 7C                          MOV  A,H                ;COUNTER IN 8155 IS 14 BIT
     700/     36C : E6 3F                       ANI  3FH                ;MAKE SURE BITS 6,7 ARE ZERO
     701/     36E : F6 40                       ORI  40H                ;SET MODE CONT. SQUARE WAVE
     702/     370 : D3 05                       OUT  PTIMH              ;SEND TO TIMER HI REGISTER
     703/     372 : 3A 02 80                    LDA  PCMCPY             ;GET THE PORT COMMAND SHADOW
     704/     375 : E6 0F                       ANI  0FH                ;REMOVE ANY UNWANTED CFGBITS
     705/     377 : F6 C0                       ORI  0C0H               ;ISSUE START COMMAND
     706/     379 : D3 00                       OUT  PCMD               ;SEND TO 8155 CONFIG REG
     707/     37B : C9                          RET
     708/     37C :                     ;
     709/     37C :                     ;*************************************************************
     710/     37C :                     ;
     711/     37C :                     ; *** GOSUB *** & RETURN ***
     712/     37C :                     ;
     713/     37C :                     ; 'GOSUB EXPR;' OR 'GOSUB EXPR (CR)' IS LIKE THE 'GOTO'
     714/     37C :                     ; COMMAND, EXCEPT THAT THE CURRENT TEXT POINTER, STACK POINTER
     715/     37C :                     ; ETC. ARE SAVE SO THAT EXECUTION CAN BE CONTINUED AFTER THE
     716/     37C :                     ; SUBROUTINE 'RETURN'.  IN ORDER THAT 'GOSUB' CAN BE NESTED
     717/     37C :                     ; (AND EVEN RECURSIVE), THE SAVE AREA MUST BE STACKED.
     718/     37C :                     ; THE STACK POINTER IS SAVED IN 'STKGOS', THE OLD 'STKGOS' IS
     719/     37C :                     ; SAVED IN THE STACK.  IF WE ARE IN THE MAIN ROUTINE, 'STKGOS'
     720/     37C :                     ; IS ZERO (THIS WAS DONE BY THE "MAIN" SECTION OF THE CODE),
     721/     37C :                     ; BUT WE STILL SAVE IT AS A FLAG FOR NO FURTHER 'RETURN'S.
     722/     37C :                     ;
     723/     37C :                     ; 'RETURN(CR)' UNDOS EVERYTHING THAT 'GOSUB' DID, AND THUS
     724/     37C :                     ; RETURN THE EXECUTION TO THE COMMAND AFTER THE MOST RECENT
     725/     37C :                     ; 'GOSUB'.  IF 'STKGOS' IS ZERO, IT INDICATES THAT WE
     726/     37C :                     ; NEVER HAD A 'GOSUB' AND IS THUS AN ERROR.
     727/     37C :                     ;
     728/     37C : CD 25 0A            GOSUB:  CALL PUSHA              ;SAVE THE CURRENT "FOR"
     729/     37F : DF                          RST  3                  ;PARAMETERS
     730/     380 : D5                          PUSH D                  ;AND TEXT POINTER
     731/     381 : CD F9 08                    CALL FNDLN              ;FIND THE TARGET LINE
     732/     384 : C4 F9 00                    CNZ  AHOW               ;NOT THERE. SAY "HOW?"
     733/     387 : 2A 06 80                    LHLD CURRNT             ;FOUND IT, SAVE OLD
     734/     38A : E5                          PUSH H                  ;'CURRNT' OLD 'STKGOS'
     735/     38B : 2A 08 80                    LHLD STKGOS
     736/     38E : E5                          PUSH H
     737/     38F : 21 00 00                    LXI  H,0                ;AND LOAD NEW ONES
     738/     392 : 22 0E 80                    SHLD LOPVAR
     739/     395 : 39                          DAD  SP
     740/     396 : 22 08 80                    SHLD STKGOS
     741/     399 : C3 BF 01                    JMP  RUNTSL             ;THEN RUN THAT LINE
     742/     39C : CD B6 07            RETURN: CALL ENDCHK             ;THERE MUST BE A CR
     743/     39F : 2A 08 80                    LHLD STKGOS             ;OLD STACK POINTER
     744/     3A2 : 7C                          MOV  A,H                ;0 MEANS NOT EXIST
     745/     3A3 : B5                          ORA  L
     746/     3A4 : CC C6 07                    CZ   QWHAT              ;SO, WE SAY: "WHAT?"
     747/     3A7 : F9                          SPHL                    ;ELSE, RESTORE IT
     748/     3A8 : E1                          POP  H
     749/     3A9 : 22 08 80                    SHLD STKGOS             ;AND THE OLD 'STKGOS'
     750/     3AC : E1                          POP  H
     751/     3AD : 22 06 80                    SHLD CURRNT             ;AND THE OLD 'CURRNT'
     752/     3B0 : D1                          POP  D                  ;OLD TEXT POINTER
     753/     3B1 : CD 09 0A                    CALL POPA               ;OLD "FOR" PARAMETERS
     754/     3B4 : F7                          RST  6                  ;AND WE ARE BACK HOME
     755/     3B5 :                     ;
     756/     3B5 :                     ;*************************************************************
     757/     3B5 :                     ;
     758/     3B5 :                     ; *** FOR *** & NEXT ***
     759/     3B5 :                     ;
     760/     3B5 :                     ; 'FOR' HAS TWO FORMS:
     761/     3B5 :                     ; 'FOR VAR=EXP1 TO EXP2 STEP EXP3' AND 'FOR VAR=EXP1 TO EXP2'
     762/     3B5 :                     ; THE SECOND FORM MEANS THE SAME THING AS THE FIRST FORM WITH
     763/     3B5 :                     ; EXP3=1.  (I.E., WITH A STEP OF +1.)
     764/     3B5 :                     ; TBI WILL FIND THE VARIABLE VAR, AND SET ITS VALUE TO THE
     765/     3B5 :                     ; CURRENT VALUE OF EXP1.  IT ALSO EVALUATES EXP2 AND EXP3
     766/     3B5 :                     ; AND SAVE ALL THESE TOGETHER WITH THE TEXT POINTER ETC. IN
     767/     3B5 :                     ; THE 'FOR' SAVE AREA, WHICH CONSISTS OF 'LOPVAR', 'LOPINC',
     768/     3B5 :                     ; 'LOPLMT', 'LOPLN', AND 'LOPPT'.  IF THERE IS ALREADY SOME-
     769/     3B5 :                     ; THING IN THE SAVE AREA (THIS IS INDICATED BY A NON-ZERO
     770/     3B5 :                     ; 'LOPVAR'), THEN THE OLD SAVE AREA IS SAVED IN THE STACK
     771/     3B5 :                     ; BEFORE THE NEW ONE OVERWRITES IT.
     772/     3B5 :                     ; TBI WILL THEN DIG IN THE STACK AND FIND OUT IF THIS SAME
     773/     3B5 :                     ; VARIABLE WAS USED IN ANOTHER CURRENTLY ACTIVE 'FOR' LOOP.
     774/     3B5 :                     ; IF THAT IS THE CASE, THEN THE OLD 'FOR' LOOP IS DEACTIVATED.
     775/     3B5 :                     ; (PURGED FROM THE STACK..)
     776/     3B5 :                     ;
     777/     3B5 :                     ; 'NEXT VAR' SERVES AS THE LOGICAL (NOT NECESSARILLY PHYSICAL)
     778/     3B5 :                     ; END OF THE 'FOR' LOOP.  THE CONTROL VARIABLE VAR. IS CHECKED
     779/     3B5 :                     ; WITH THE 'LOPVAR'.  IF THEY ARE NOT THE SAME, TBI DIGS IN
     780/     3B5 :                     ; THE STACK TO FIND THE RIGHT ONE AND PURGES ALL THOSE THAT
     781/     3B5 :                     ; DID NOT MATCH.  EITHER WAY, TBI THEN ADDS THE 'STEP' TO
     782/     3B5 :                     ; THAT VARIABLE AND CHECK THE RESULT WITH THE LIMIT.  IF IT
     783/     3B5 :                     ; IS WITHIN THE LIMIT, CONTROL LOOPS BACK TO THE COMMAND
     784/     3B5 :                     ; FOLLOWING THE 'FOR'.  IF OUTSIDE THE LIMIT, THE SAVE AREA
     785/     3B5 :                     ; IS PURGED AND EXECUTION CONTINUES.
     786/     3B5 :                     ;
     787/     3B5 : CD 25 0A            FOR:    CALL PUSHA              ;SAVE THE OLD SAVE AREA
     788/     3B8 : CD 92 07                    CALL SETVAL             ;SET THE CONTROL VAR.
     789/     3BB : 2B                          DCX  H                  ;HL IS ITS ADDRESS
     790/     3BC : 22 0E 80                    SHLD LOPVAR             ;SAVE THAT
     791/     3BF : 21 DB 0B                    LXI  H,TAB5-1           ;USE 'EXEC' TO LOOK
     792/     3C2 : C3 1A 0C                    JMP  EXEC               ;FOR THE WORD 'TO'
     793/     3C5 : DF                  FR1:    RST  3                  ;EVALUATE THE LIMIT
     794/     3C6 : 22 12 80                    SHLD LOPLMT             ;SAVE THAT
     795/     3C9 : 21 E1 0B                    LXI  H,TAB6-1           ;USE 'EXEC' TO LOOK
     796/     3CC : C3 1A 0C                    JMP EXEC                ;FOR THE WORD 'STEP'
     797/     3CF : DF                  FR2:    RST  3                  ;FOUND IT, GET STEP
     798/     3D0 : C3 D6 03                    JMP  FR4
     799/     3D3 : 21 01 00            FR3:    LXI  H,1H               ;NOT FOUND, SET TO 1
     800/     3D6 : 22 10 80            FR4:    SHLD LOPINC             ;SAVE THAT TOO
     801/     3D9 : 2A 06 80            FR5:    LHLD CURRNT             ;SAVE CURRENT LINE #
     802/     3DC : 22 14 80                    SHLD LOPLN
     803/     3DF : EB                          XCHG                    ;AND TEXT POINTER
     804/     3E0 : 22 16 80                    SHLD LOPPT
     805/     3E3 : 01 0A 00                    LXI  B,0AH              ;DIG INTO STACK TO
     806/     3E6 : 2A 0E 80                    LHLD LOPVAR             ;FIND 'LOPVAR'
     807/     3E9 : EB                          XCHG
     808/     3EA : 60                          MOV  H,B
     809/     3EB : 68                          MOV  L,B                ;HL=0 NOW
     810/     3EC : 39                          DAD  SP                 ;HERE IS THE STACK
     811/     3ED : 3E                          DB   3EH
     812/     3EE : 09                  FR7:    DAD  B                  ;EACH LEVEL IS 10 DEEP
     813/     3EF : 7E                          MOV  A,M                ;GET THAT OLD 'LOPVAR'
     814/     3F0 : 23                          INX  H
     815/     3F1 : B6                          ORA  M
     816/     3F2 : CA 0F 04                    JZ   FR8                ;0 SAYS NO MORE IN IT
     817/     3F5 : 7E                          MOV  A,M
     818/     3F6 : 2B                          DCX  H
     819/     3F7 : BA                          CMP  D                  ;SAME AS THIS ONE?
     820/     3F8 : C2 EE 03                    JNZ  FR7
     821/     3FB : 7E                          MOV  A,M                ;THE OTHER HALF?
     822/     3FC : BB                          CMP  E
     823/     3FD : C2 EE 03                    JNZ  FR7
     824/     400 : EB                          XCHG                    ;YES, FOUND ONE
     825/     401 : 21 00 00                    LXI  H,0H
     826/     404 : 39                          DAD  SP                 ;TRY TO MOVE SP
     827/     405 : 44                          MOV  B,H
     828/     406 : 4D                          MOV  C,L
     829/     407 : 21 0A 00                    LXI  H,0AH
     830/     40A : 19                          DAD  D
     831/     40B : CD FA 09                    CALL MVDOWN             ;AND PURGE 10 WORDS
     832/     40E : F9                          SPHL                    ;IN THE STACK
     833/     40F : 2A 16 80            FR8:    LHLD LOPPT              ;JOB DONE, RESTORE DE
     834/     412 : EB                          XCHG
     835/     413 : F7                          RST  6                  ;AND CONTINUE
     836/     414 : CD C6 07            FR9:    CALL QWHAT
     837/     417 :                     ;
     838/     417 : CD 4D 00            NEXT:   CALL TSTV               ;GET ADDRESS OF VAR.
     839/     41A : DC C6 07                    CC   QWHAT              ;NO VARIABLE, "WHAT?"
     840/     41D : 22 0A 80                    SHLD VARNXT             ;YES, SAVE IT
     841/     420 : D5                  NX0:    PUSH D                  ;SAVE TEXT POINTER
     842/     421 : EB                          XCHG
     843/     422 : 2A 0E 80                    LHLD LOPVAR             ;GET VAR. IN 'FOR'
     844/     425 : 7C                          MOV  A,H
     845/     426 : B5                          ORA  L                  ;0 SAYS NEVER HAD ONE
     846/     427 : CC C3 07                    CZ   AWHAT              ;SO WE ASK: "WHAT?"
     847/     42A : E7                          RST  4                  ;ELSE WE CHECK THEM
     848/     42B : CA 38 04                    JZ   NX3                ;OK, THEY AGREE
     849/     42E : D1                          POP  D                  ;NO, LET'S SEE
     850/     42F : CD 09 0A                    CALL POPA               ;PURGE CURRENT LOOP
     851/     432 : 2A 0A 80                    LHLD VARNXT             ;AND POP ONE LEVEL
     852/     435 : C3 20 04                    JMP  NX0                ;GO CHECK AGAIN
     853/     438 : 5E                  NX3:    MOV  E,M                ;COME HERE WHEN AGREED
     854/     439 : 23                          INX  H
     855/     43A : 56                          MOV  D,M                ;DE=VALUE OF VAR.
     856/     43B : 2A 10 80                    LHLD LOPINC
     857/     43E : E5                          PUSH H
     858/     43F : 7C                          MOV  A,H
     859/     440 : AA                          XRA  D
     860/     441 : 7A                          MOV  A,D
     861/     442 : 19                          DAD  D                  ;ADD ONE STEP
     862/     443 : FA 4A 04                    JM   NX4
     863/     446 : AC                          XRA  H
     864/     447 : FA 6C 04                    JM   NX5
     865/     44A : EB                  NX4:    XCHG
     866/     44B : 2A 0E 80                    LHLD LOPVAR             ;PUT IT BACK
     867/     44E : 73                          MOV  M,E
     868/     44F : 23                          INX  H
     869/     450 : 72                          MOV  M,D
     870/     451 : 2A 12 80                    LHLD LOPLMT             ;HL->LIMIT
     871/     454 : F1                          POP  PSW                ;OLD HL
     872/     455 : B7                          ORA  A
     873/     456 : F2 5A 04                    JP   NX1                ;STEP > 0
     874/     459 : EB                          XCHG                    ;STEP < 0
     875/     45A : CD 83 07            NX1:    CALL CKHLDE             ;COMPARE WITH LIMIT
     876/     45D : D1                          POP  D                  ;RESTORE TEXT POINTER
     877/     45E : DA 6E 04                    JC   NX2                ;OUTSIDE LIMIT
     878/     461 : 2A 14 80                    LHLD LOPLN              ;WITHIN LIMIT, GO
     879/     464 : 22 06 80                    SHLD CURRNT             ;BACK TO THE SAVED
     880/     467 : 2A 16 80                    LHLD LOPPT              ;'CURRNT' AND TEXT
     881/     46A : EB                          XCHG                    ;POINTER
     882/     46B : F7                          RST  6
     883/     46C : E1                  NX5:    POP  H
     884/     46D : D1                          POP  D
     885/     46E : CD 09 0A            NX2:    CALL POPA               ;PURGE THIS LOOP
     886/     471 : F7                          RST  6
     887/     472 :                     ;
     888/     472 :                     ;*************************************************************
     889/     472 :                     ;
     890/     472 :                     ; *** REM *** IF *** INPUT *** & LET (& DEFLT) ***
     891/     472 :                     ;
     892/     472 :                     ; 'REM' CAN BE FOLLOWED BY ANYTHING AND IS IGNORED BY TBI.
     893/     472 :                     ; TBI TREATS IT LIKE AN 'IF' WITH A FALSE CONDITION.
     894/     472 :                     ;
     895/     472 :                     ; 'IF' IS FOLLOWED BY AN EXPR. AS A CONDITION AND ONE OR MORE
     896/     472 :                     ; COMMANDS (INCLUDING OTHER 'IF'S) SEPERATED BY SEMI-COLONS.
     897/     472 :                     ; NOTE THAT THE WORD 'THEN' IS NOT USED.  TBI EVALUATES THE
     898/     472 :                     ; EXPR. IF IT IS NON-ZERO, EXECUTION CONTINUES.  IF THE
     899/     472 :                     ; EXPR. IS ZERO, THE COMMANDS THAT FOLLOWS ARE IGNORED AND
     900/     472 :                     ; EXECUTION CONTINUES AT THE NEXT LINE.
     901/     472 :                     ;
     902/     472 :                     ; 'INPUT' COMMAND IS LIKE THE 'PRINT' COMMAND, AND IS FOLLOWED
     903/     472 :                     ; BY A LIST OF ITEMS.  IF THE ITEM IS A STRING IN SINGLE OR
     904/     472 :                     ; DOUBLE QUOTES, OR IS A BACK-ARROW, IT HAS THE SAME EFFECT AS
     905/     472 :                     ; IN 'PRINT'.  IF AN ITEM IS A VARIABLE, THIS VARIABLE NAME IS
     906/     472 :                     ; PRINTED OUT FOLLOWED BY A COLON.  THEN TBI WAITS FOR AN
     907/     472 :                     ; EXPR. TO BE TYPED IN.  THE VARIABLE IS THEN SET TO THE
     908/     472 :                     ; VALUE OF THIS EXPR.  IF THE VARIABLE IS PROCEDED BY A STRING
     909/     472 :                     ; (AGAIN IN SINGLE OR DOUBLE QUOTES), THE STRING WILL BE
     910/     472 :                     ; PRINTED FOLLOWED BY A COLON.  TBI THEN WAITS FOR INPUT EXPR.
     911/     472 :                     ; AND SET THE VARIABLE TO THE VALUE OF THE EXPR.
     912/     472 :                     ;
     913/     472 :                     ; IF THE INPUT EXPR. IS INVALID, TBI WILL PRINT "WHAT?",
     914/     472 :                     ; "HOW?" OR "SORRY" AND REPRINT THE PROMPT AND REDO THE INPUT.
     915/     472 :                     ; THE EXECUTION WILL NOT TERMINATE UNLESS YOU TYPE CONTROL-C.
     916/     472 :                     ; THIS IS HANDLED IN 'INPERR'.
     917/     472 :                     ;
     918/     472 :                     ; 'LET' IS FOLLOWED BY A LIST OF ITEMS SEPERATED BY COMMAS.
     919/     472 :                     ; EACH ITEM CONSISTS OF A VARIABLE, AN EQUAL SIGN, AND AN EXPR.
     920/     472 :                     ; TBI EVALUATES THE EXPR. AND SET THE VARIABLE TO THAT VALUE.
     921/     472 :                     ; TBI WILL ALSO HANDLE 'LET' COMMAND WITHOUT THE WORD 'LET'.
     922/     472 :                     ; THIS IS DONE BY 'DEFLT'.
     923/     472 :                     ;
     924/     472 :                     ; 'REM' PUTS ZERO IN HL TO MAKE A FALSE IF STATEMENT. THEN COMES
     925/     472 :                     ; 3EH WHICH GETS EXECUTED AS OPCODE 3EH (MVI A,_). NEXT INSTR.
     926/     472 :                     ; IS 'RST 3' (OPCODE DFH) WHICH BECOMES DATA FOR THE MVI A,_
     927/     472 :                     ; SO 3EH +'RST 3' FORMS A DUMMY INSTRUCTION (MVI A,DFH) TO REACH
     928/     472 :                     ; THE NEXT INTENDED USEFUL INSTRUCTION WHICH IS MOV A,H AND THEN
     929/     472 :                     ; 'IF' STATEMENT CONTINUES. INTERSTING WAY TO MAKE A NON-JUMP..
     930/     472 :                     ;
     931/     472 : 21 00 00            REM:    LXI  H,0H               ;*** REM ***
     932/     475 : 3E                          DB   3EH                ;THIS IS LIKE 'IF 0'
     933/     476 :                     ;
     934/     476 : DF                  IFF:    RST  3                  ;*** IF ***
     935/     477 : 7C                          MOV  A,H                ;IS THE EXPR.=0?
     936/     478 : B5                          ORA  L
     937/     479 : C2 C6 01                    JNZ  RUNSML             ;NO, CONTINUE
     938/     47C : CD 17 09                    CALL FNDSKP             ;YES, SKIP REST OF LINE
     939/     47F : D2 BF 01                    JNC  RUNTSL             ;AND RUN THE NEXT LINE
     940/     482 : C3 2D 01                    JMP  RSTART             ;IF NO NEXT, RE-START
     941/     485 :                     ;
     942/     485 : 2A 0C 80            INPERR: LHLD STKINP             ;*** INPERR ***
     943/     488 : F9                          SPHL                    ;RESTORE OLD SP
     944/     489 : E1                          POP  H                  ;AND OLD 'CURRNT'
     945/     48A : 22 06 80                    SHLD CURRNT
     946/     48D : D1                          POP  D                  ;AND OLD TEXT POINTER
     947/     48E : D1                          POP  D                  ;REDO INPUT
     948/     48F :                     ;
     949/     48F :                     INPUT:                          ;*** INPUT ***
     950/     48F : D5                  IP1:    PUSH D                  ;SAVE IN CASE OF ERROR
     951/     490 : CD 2D 09                    CALL QTSTG              ;IS NEXT ITEM A STRING?
     952/     493 : C3 9F 04                    JMP  IP2                ;NO
     953/     496 : CD 4D 00                    CALL TSTV               ;YES, BUT FOLLOWED BY A
     954/     499 : DA D8 04                    JC   IP4                ;VARIABLE?   NO.
     955/     49C : C3 B1 04                    JMP  IP3                ;YES.  INPUT VARIABLE
     956/     49F : D5                  IP2:    PUSH D                  ;SAVE FOR 'PRTSTG'
     957/     4A0 : CD 4D 00                    CALL TSTV               ;MUST BE VARIABLE NOW
     958/     4A3 : DC C6 07                    CC   QWHAT              ;"WHAT?" IT IS NOT?
     959/     4A6 : 1A                          LDAX D                  ;GET READY FOR 'PRTSTR'
     960/     4A7 : 4F                          MOV  C,A
     961/     4A8 : 97                          SUB  A
     962/     4A9 : 12                          STAX D
     963/     4AA : D1                          POP  D
     964/     4AB : CD 21 09                    CALL PRTSTG             ;PRINT STRING AS PROMPT
     965/     4AE : 79                          MOV  A,C                ;RESTORE TEXT
     966/     4AF : 1B                          DCX  D
     967/     4B0 : 12                          STAX D
     968/     4B1 : D5                  IP3:    PUSH D                  ;SAVE TEXT POINTER
     969/     4B2 : EB                          XCHG
     970/     4B3 : 2A 06 80                    LHLD CURRNT             ;ALSO SAVE 'CURRNT'
     971/     4B6 : E5                          PUSH H
     972/     4B7 : 21 8F 04                    LXI  H,IP1              ;PTR TO A NEG.NUMBER
     973/     4BA : 22 06 80                    SHLD CURRNT             ;AS A FLAG
     974/     4BD : 21 00 00                    LXI  H,0H               ;SAVE SP TOO
     975/     4C0 : 39                          DAD  SP
     976/     4C1 : 22 0C 80                    SHLD STKINP
     977/     4C4 : D5                          PUSH D                  ;OLD HL
     978/     4C5 : 3E 3A                       MVI  A,':'              ;PRINT THIS TOO
     979/     4C7 : CD 14 08                    CALL GETLN              ;AND GET A LINE
     980/     4CA : 11 36 BF                    LXI  D,BUFFER           ;POINTS TO BUFFER
     981/     4CD : DF                          RST  3                  ;EVALUATE INPUT
     982/     4CE : D1                          POP  D                  ;OK, GET OLD HL
     983/     4CF : EB                          XCHG
     984/     4D0 : 73                          MOV  M,E                ;SAVE VALUE IN VAR.
     985/     4D1 : 23                          INX  H
     986/     4D2 : 72                          MOV  M,D
     987/     4D3 : E1                          POP  H                  ;GET OLD 'CURRNT'
     988/     4D4 : 22 06 80                    SHLD CURRNT
     989/     4D7 : D1                          POP  D                  ;AND OLD TEXT POINTER
     990/     4D8 : F1                  IP4:    POP  PSW                ;PURGE JUNK IN STACK
     991/     4D9 : CF                          RST  1                  ;IS NEXT CH. ','?
     992/     4DA : 2C                          DB   ','
     993/     4DB : 03                          DB   IP5-$-1
     994/     4DC : C3 8F 04                    JMP  IP1                ;YES, MORE ITEMS.
     995/     4DF : F7                  IP5:    RST  6
     996/     4E0 :                     ;
     997/     4E0 : 1A                  DEFLT:  LDAX D                  ;***  DEFLT ***
     998/     4E1 : FE 0D                       CPI  CR                 ;EMPTY LINE IS OK
     999/     4E3 : CA EF 04                    JZ   LT1                ;ELSE IT IS 'LET'
    1000/     4E6 :                     ;
    1001/     4E6 : CD 92 07            LET:    CALL SETVAL             ;*** LET ***
    1002/     4E9 : CF                          RST  1                  ;SET VALUE TO VAR.
    1003/     4EA : 2C                          DB   ','
    1004/     4EB : 03                          DB   LT1-$-1
    1005/     4EC : C3 E6 04                    JMP  LET                ;ITEM BY ITEM
    1006/     4EF : F7                  LT1:    RST  6                  ;UNTIL FINISH
    1007/     4F0 :                     ;
    1008/     4F0 :                     ;*************************************************************
    1009/     4F0 :                     ;
    1010/     4F0 :                     ; *** EXPR ***
    1011/     4F0 :                     ;
    1012/     4F0 :                     ; 'EXPR' EVALUATES ARITHMETICAL OR LOGICAL EXPRESSIONS.
    1013/     4F0 :                     ; <EXPR>::<EXPR0>
    1014/     4F0 :                     ;         <EXPR0><REL.OP.><EXPR0>
    1015/     4F0 :                     ; WHERE <REL.OP.> IS ONE OF THE OPERATORS IN TAB8 AND THE
    1016/     4F0 :                     ; RESULT OF THESE OPERATIONS IS 1 IF TRUE AND 0 IF FALSE.
    1017/     4F0 :                     ; <EXPR0>::=<EXPR1>(|, ^ OR &)<EXPR1>(....)
    1018/     4F0 :                     ; <EXPR1>::=<EXPR2>(<< OR >>)<EXPR2>(....)
    1019/     4F0 :                     ; <EXPR2>::=(+ OR -)<EXPR3>(+ OR -)<EXPR3>(....)
    1020/     4F0 :                     ; WHERE () ARE OPTIONAL AND (....) ARE OPTIONAL REPEATS.
    1021/     4F0 :                     ; <EXPR3>::=<EXPR4>(*, % OR /><EXPR4>)(....)
    1022/     4F0 :                     ; <EXPR4>::=<VARIABLE>, <FUNCTION> OR (<EXPR>)
    1023/     4F0 :                     ; <EXPR> IS RECURSIVE SO THAT VARIABLE '@' CAN HAVE AN <EXPR>
    1024/     4F0 :                     ; AS INDEX, FUNCTIONS CAN HAVE AN <EXPR> AS ARGUMENTS, AND
    1025/     4F0 :                     ; <EXPR4> CAN BE AN <EXPR> IN PARANTHESE.
    1026/     4F0 :                     ;
    1027/     4F0 :                     ;EXPR:  CALL EXPR0              ;THIS IS AT LOC. 18
    1028/     4F0 :                     ;       PUSH H                  ;SAVE <EXPR0> VALUE
    1029/     4F0 : 21 E9 0B            RELOP:  LXI  H,TAB8-1           ;LOOKUP REL.OP.
    1030/     4F3 : C3 1A 0C                    JMP  EXEC               ;GO DO IT
    1031/     4F6 : CD 1F 05            ROP1:   CALL ROP8               ;REL.OP.">="
    1032/     4F9 : D8                          RC                      ;NO, RETURN HL=0
    1033/     4FA : 6F                          MOV  L,A                ;YES, RETURN HL=1
    1034/     4FB : C9                          RET
    1035/     4FC : CD 1F 05            ROP2:   CALL ROP8               ;REL.OP."!="
    1036/     4FF : C8                          RZ                      ;FALSE, RETURN HL=0
    1037/     500 : 6F                          MOV  L,A                ;TRUE, RETURN HL=1
    1038/     501 : C9                          RET
    1039/     502 : CD 1F 05            ROP3:   CALL ROP8               ;REL.OP.">"
    1040/     505 : C8                          RZ                      ;FALSE
    1041/     506 : D8                          RC                      ;ALSO FALSE, HL=0
    1042/     507 : 6F                          MOV  L,A                ;TRUE, HL=1
    1043/     508 : C9                          RET
