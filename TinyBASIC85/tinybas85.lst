     197/      8F : 44                          MOV  B,H                ;TEST IF THE TEXT IS
     198/      90 : EF                          RST  5                  ;A NUMBER
     199/      91 : FE 27                       CPI  27H                ;TEST FOR SINGLE QUOTE
     200/      93 : C2 A3 00                    JNZ  TN0                ;NO, TRY HEXADECIMAL
     201/      96 : 13                          INX  D                  ;BUMP TXTPTR TO VALUE
     202/      97 : 1A                          LDAX D                  ;GET IT
     203/      98 : 6F                          MOV  L,A                ;RETURN IN (H)L
     204/      99 : 04                          INR  B                  ;INDICATE DIGIT FOUND
     205/      9A : 13                          INX  D                  ;BUMP PTR
     206/      9B : 1A                          LDAX D                  ;AND TEST
     207/      9C : FE 27                       CPI  27H                ;CLOSING QUOTE
     208/      9E : C4 C6 07                    CNZ QWHAT               ;IF NOT IT'S ERROR
     209/      A1 : 13                          INX  D                  ;OTHERWISE BUMP TXTPTR
