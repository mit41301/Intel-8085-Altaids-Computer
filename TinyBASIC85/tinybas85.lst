    2021/     9F1 :                     ;
    2022/     9F1 :                     ; *** MVUP *** MVDOWN *** POPA *** & PUSHA ***
    2023/     9F1 :                     ;
    2024/     9F1 :                     ; 'MVUP' MOVES A BLOCK UP FROM WHERE DE-> TO WHERE BC-> UNTIL
    2025/     9F1 :                     ; DE = HL
    2026/     9F1 :                     ;
    2027/     9F1 :                     ; 'MVDOWN' MOVES A BLOCK DOWN FROM WHERE DE-> TO WHERE HL->
    2028/     9F1 :                     ; UNTIL DE = BC
    2029/     9F1 :                     ;
    2030/     9F1 :                     ; 'POPA' RESTORES THE 'FOR' LOOP VARIABLE SAVE AREA FROM THE
    2031/     9F1 :                     ; STACK
    2032/     9F1 :                     ;
    2033/     9F1 :                     ; 'PUSHA' STACKS THE 'FOR' LOOP VARIABLE SAVE AREA INTO THE
    2034/     9F1 :                     ; STACK
    2035/     9F1 :                     ;
    2036/     9F1 : E7                  MVUP:   RST  4                  ;*** MVUP ***
    2037/     9F2 : C8                          RZ                      ;DE = HL, RETURN
    2038/     9F3 : 1A                          LDAX D                  ;GET ONE BYTE
    2039/     9F4 : 02                          STAX B                  ;MOVE IT
    2040/     9F5 : 13                          INX  D                  ;INCREASE BOTH POINTERS
    2041/     9F6 : 03                          INX  B
    2042/     9F7 : C3 F1 09                    JMP  MVUP               ;UNTIL DONE
    2043/     9FA :                     ;
    2044/     9FA : 78                  MVDOWN: MOV  A,B                ;*** MVDOWN ***
    2045/     9FB : 92                          SUB  D                  ;TEST IF DE = BC
    2046/     9FC : C2 02 0A                    JNZ  MD1                ;NO, GO MOVE
    2047/     9FF : 79                          MOV  A,C                ;MAYBE, OTHER BYTE?
    2048/     A00 : 93                          SUB  E
    2049/     A01 : C8                          RZ                      ;YES, RETURN
    2050/     A02 : 1B                  MD1:    DCX  D                  ;ELSE MOVE A BYTE
    2051/     A03 : 2B                          DCX  H                  ;BUT FIRST DECREASE
    2052/     A04 : 1A                          LDAX D                  ;BOTH POINTERS AND
    2053/     A05 : 77                          MOV  M,A                ;THEN DO IT
    2054/     A06 : C3 FA 09                    JMP  MVDOWN             ;LOOP BACK
    2055/     A09 :                     ;
    2056/     A09 : C1                  POPA:   POP  B                  ;BC = RETURN ADDR.
    2057/     A0A : E1                          POP  H                  ;RESTORE LOPVAR, BUT
    2058/     A0B : 22 0E 80                    SHLD LOPVAR             ;=0 MEANS NO MORE
