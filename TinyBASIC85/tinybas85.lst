     212/      A5 : C2 CE 00                    JNZ  TN1                ;NO, TRY DECIMAL
     213/      A8 : 13                  TN2:    INX  D                  ;YES, IT'S HEXADEC.
     214/      A9 : 1A                          LDAX D                  ;EVALUATE NEXT CHAR
     215/      AA : D6 30                       SUI  '0'                ;GO FROM ASCII TO HEX
     216/      AC : DA C8 00                    JC   TN4                ;QUIT IF ASCII BELOW '0'
     217/      AF : FE 0A                       CPI  0AH                ;CHECK IF BELOW 0AH
     218/      B1 : DA BB 00                    JC   TN3                ;OK, CONVERT
     219/      B4 : D6 07                       SUI  'A'-'9'-1          ;ELSE SUB DIFF TO 'A'
     220/      B6 : FE 10                       CPI  10H                ;CHECK IF BELOW 10H
     221/      B8 : D2 C8 00                    JNC  TN4                ;QUIT IF NOT
     222/      BB : 29                  TN3:    DAD  H                  ;RIGHT SHIFT FOUR POS
     223/      BC : 29                          DAD  H                  ;EQUALS MULTIPLICATION
     224/      BD : 29                          DAD  H                  ;BY 16
     225/      BE : 29                          DAD  H
     226/      BF : DC FC 00                    CC   QHOW               ;CARRY MEANS OVERFLOW
     227/      C2 : B5                          ORA  L                  ;ADD THE NEW DIGIT
