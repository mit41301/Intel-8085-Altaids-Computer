    1395/     6FF : 3A 00 80                    LDA  RCVCHR             ;GET LAST RCVD CHAR
    1396/     702 : 6F                          MOV  L,A                ;RETURN IN HL
    1397/     703 : AF                          XRA  A                  ;RESET THE
    1398/     704 : 32 00 80                    STA  RCVCHR             ;RCVD CHAR AFTER READ
    1399/     707 : C9                          RET
    1400/     708 :                     ;
    1401/     708 : FF                  USR:    RST  7                  ;** USR(EXPR)[,REGS..] **
    1402/     709 : 22 86 BF                    SHLD STKLMT+6           ;SAVE 1ST ARG, CALL ADDR
    1403/     70C : CD BD 07                    CALL SKPCOM             ;COMMA MAY SEPARATE ARGS
    1404/     70F : CA 16 07                    JZ   US1                ;WE HAVE MORE ARGUMENTS
    1405/     712 : D5                          PUSH D                  ;ELSE SAVE TXTPTR
    1406/     713 : C3 2B 07                    JMP  US2                ;AND CONTINUE W/O ARGS
    1407/     716 : FF                  US1:    RST  7                  ;GET 2ND ARG WHICH IS HL
    1408/     717 : E5                          PUSH H                  ;SAVE IT
    1409/     718 : CD BD 07                    CALL SKPCOM             ;COMMA MAY SEPARATE ARGS
    1410/     71B : FF                          RST  7                  ;GET 3RD ARG WICH IS DE
    1411/     71C : E5                          PUSH H                  ;BUT DE IS TXTPTR SO SAVE
    1412/     71D : CD BD 07                    CALL SKPCOM             ;COMMA MAY SEPARATE ARGS
    1413/     720 : FF                          RST  7                  ;GET 4TH ARG
