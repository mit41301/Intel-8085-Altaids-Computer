    1960/     997 : C3 8E 09                    JMP  PN4                ;MORE?
    1961/     99A : 78                  PN5:    MOV  A,B                ;PRINT SIGN
    1962/     99B : B7                          ORA  A
    1963/     99C : C4 10 00                    CNZ  OUTC
    1964/     99F : 5D                          MOV  E,L                ;LAST REMAINDER IN E
    1965/     9A0 : 7B                  PN6:    MOV  A,E                ;CHECK DIGIT IN E
    1966/     9A1 : FE 0A                       CPI  0AH                ;10 IS FLAG FOR NO MORE
    1967/     9A3 : D1                          POP  D
    1968/     9A4 : C8                          RZ                      ;IF SO, RETURN
    1969/     9A5 : C6 30                       ADI  '0'                ;ELSE CONVERT TO ASCII
    1970/     9A7 : D7                          RST  2                  ;AND PRINT THE DIGIT
    1971/     9A8 : C3 A0 09                    JMP  PN6                ;GO BACK FOR MORE
    1972/     9AB :                     ;
    1973/     9AB : 1A                  PRTLN:  LDAX D                  ;*** PRTLN ***
    1974/     9AC : 6F                          MOV  L,A                ;LOW ORDER LINE #
