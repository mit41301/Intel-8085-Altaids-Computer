    2104/     A50 : 97                          SUB  A                  ;RESET A
    2105/     A51 : D3 30                       OUT  SELECT             ;RESET D F/F SELECT LINES
    2106/     A53 : D3 11                       OUT  UARTC              ;PUT 8251 IN COMMAND MODE
    2107/     A55 : D3 11                       OUT  UARTC              ;WRITE 0 THREE TIMES
    2108/     A57 : D3 11                       OUT  UARTC
    2109/     A59 : 3E 40                       MVI  A,URESET           ;RESET COMMAND
    2110/     A5B : D3 11                       OUT  UARTC              ;WRITE IT TO 8251 USART
    2111/     A5D : 3E 4E                       MVI  A,USETUP           ;8 DATA, 1 STOP, X16
    2112/     A5F : D3 11                       OUT  UARTC              ;WRITE IT TO 8251 USART
    2113/     A61 : 3E 15                       MVI  A,UENABL           ;ERRST, RXEN, TXEN
    2114/     A63 : D3 11                       OUT  UARTC              ;WRITE IT TO 8251 USART
    2115/     A65 :                     ;
    2116/     A65 : 21 00 80            ZMEM:   LXI  H,RAMBGN           ;ZERO OUT MEMORY FROM
    2117/     A68 : 11 80 BF                    LXI  D,STKLMT           ;RAMBEGIN TO STACKLIMIT
    2118/     A6B : 36 00               ZMEM1:  MVI  M,0
    2119/     A6D : 23                          INX  H
    2120/     A6E : E7                          RST  4                  ;USE RST 4 TO COMPARE
    2121/     A6F : C2 6B 0A                    JNZ  ZMEM1              ;16k LOOP TAKES 305ms
    2122/     A72 :                     ;
    2123/     A72 : 21 00 18                    LXI  H,6144             ;INITIATE DEFAULT XTAL[kHz]
    2124/     A75 : CD 67 03                    CALL SETXTL             ;START TIMER TO GET INT7.5
    2125/     A78 : 3E 1B                       MVI  A,1BH              ;RST F/F & ENABLE INT7.5
    2126/     A7A : 30                          SIM                     ;SET THE NEW MASK
    2127/     A7B : FB                          EI                      ;ENABLE INTERRUPT
    2128/     A7C :                     ;
    2129/     A7C : 01 00 00                    LXI  B,EESTRT           ;START ADR IN EEPROM
    2130/     A7F : 11 02 00                    LXI  D,2                ;LENGTH TO READ
    2131/     A82 : 21 18 80                    LXI  H,RNDNUM           ;WHERE TO STORE IT
    2132/     A85 : CD 92 0C                    CALL EERD               ;READ THE EEPROM
    2133/     A88 : 2A 18 80                    LHLD RNDNUM             ;GET THE VALUE AGAIN
    2134/     A8B : 23                          INX  H                  ;INCREMENT AND SAVE
    2135/     A8C : 22 18 80                    SHLD RNDNUM             ;THIS VALUE AS NEXT
    2136/     A8F : 01 00 00                    LXI  B,EESTRT           ;RANDOM NUMBER SEED
    2137/     A92 : 11 02 00                    LXI  D,2                ;IN THIS WAY THE RANDOM
    2138/     A95 : 21 18 80                    LXI  H,RNDNUM           ;SEQUENCE WILL NOT
    2139/     A98 : CD EE 0C                    CALL EEWR               ;REPEAT EVERY POWER ON
    2140/     A9B :                     ;
    2141/     A9B : CD 1A 01                    CALL ST1                ;MAKE RSTART INITALIZATION
    2142/     A9E : DB 03                       IN   PORTC              ;BACK DOOR TO ESCAPE FROM
    2143/     AA0 : E6 18                       ANI  18H                ;ROUGE AUTORUN PRG EEPROM
    2144/     AA2 : CA B1 0A                    JZ   CONT               ;BY PRESSING BTNS PC3+PC4
    2145/     AA5 : CD 02 02                    CALL LD0                ;TRY READ PGM FROM EEPROM
    2146/     AA8 : 11 22 80                    LXI  D,TXTBGN+6         ;AFTER 2 BYTE LINE NUM
    2147/     AAB :                                                     ;AND STATEMENT "REM " WE
    2148/     AAB : 21 0B 0C                    LXI  H,TAB10-1          ;MAY FIND TEXT 'AUTORUN'
    2149/     AAE : C3 1A 0C                    JMP  EXEC               ;IF SO RUN THE PROGRAM
    2150/     AB1 :                     ;
    2151/     AB1 : 21 1C 80            CONT:   LXI  H,TXTBGN           ;ELSE, DISCARD WHATEVER
    2152/     AB4 : 22 1A 80                    SHLD TXTUNF             ;PGM READ FROM EEPROM
    2153/     AB7 : 3E 35                       MVI  A,UENABL+URTS      ;MAKE SHORT BEEP AT START
    2154/     AB9 : D3 11                       OUT  UARTC              ;GETS TURNED OFF AT ST0
    2155/     ABB : 21 38 0D                    LXI  H,MSG0             ;PRINT THE START MESSAGE
    2156/     ABE : CD C4 0A                    CALL PSTR
    2157/     AC1 : C3 33 01                    JMP  ST0
    2158/     AC4 :                     ;
    2159/     AC4 : 7E                  PSTR:   MOV  A,M                ;GET A CHARACTER
    2160/     AC5 : 23                          INX  H                  ;BUMP POINTER
    2161/     AC6 : B7                          ORA  A                  ;CHR IS ZERO?
    2162/     AC7 : C8                          RZ                      ;YES, RETURN
    2163/     AC8 : D7                          RST  2                  ;ELSE PRINT IT
    2164/     AC9 : C3 C4 0A                    JMP  PSTR               ;GET NEXT
    2165/     ACC :                     ;
    2166/     ACC :                     ;*************************************************************
    2167/     ACC :                     ;
    2168/     ACC :                     ; *** OUTC *** & CHKIO ***
    2169/     ACC :                     ;
    2170/     ACC :                     ; THESE ARE THE ONLY I/O ROUTINES IN TBI.
    2171/     ACC :                     ; IT WILL OUTPUT THE BYTE IN A.  IF THAT IS A CR, A LF IS ALSO
    2172/     ACC :                     ; SEND OUT.  ONLY THE FLAGS MAY BE CHANGED AT RETURN. ALL REG.
    2173/     ACC :                     ; ARE RESTORED.
    2174/     ACC :                     ;
    2175/     ACC :                     ; 'CHKIO' CHECKS THE INPUT.  IF NO INPUT, IT WILL RETURN TO
    2176/     ACC :                     ; THE CALLER WITH THE Z FLAG SET.  IF THERE IS INPUT, Z FLAG
    2177/     ACC :                     ; IS CLEARED AND THE INPUT BYTE IS IN A. IF A CONTROL-C IS READ,
    2178/     ACC :                     ; 'CHKIO' WILL RESTART TBI AND DO NOT RETURN TO THE CALLER.
    2179/     ACC :                     ;
    2180/     ACC :                     ;OUTC:  PUSH PSW                ;THIS IS AT LOC. 10
    2181/     ACC : DB 11               OC3:    IN   UARTC              ;COME HERE TO DO OUTPUT
    2182/     ACE : E6 01                       ANI  1H                 ;STATUS BIT
    2183/     AD0 : CA CC 0A                    JZ   OC3                ;NOT READY, WAIT
    2184/     AD3 : F1                          POP  PSW                ;READY, GET OLD A BACK
    2185/     AD4 : D3 10                       OUT  UARTD              ;AND SEND IT OUT
    2186/     AD6 : FE 0D                       CPI  CR                 ;WAS IT CR?
    2187/     AD8 : C0                          RNZ                     ;NO, FINISHED
    2188/     AD9 : 3E 0A                       MVI  A,LF               ;YES, WE SEND LF TOO
    2189/     ADB : D7                          RST  2                  ;THIS IS RECURSIVE
    2190/     ADC : 3E 0D                       MVI  A,CR               ;GET CR BACK IN A
    2191/     ADE : C9                          RET
    2192/     ADF :                     ;
    2193/     ADF : CD E6 0A            INCHR:  CALL CHKIO              ;CHECK IF CHAR RCVD
    2194/     AE2 : CA DF 0A                    JZ   INCHR              ;IF NOT, CHECK AGAIN
    2195/     AE5 : C9                          RET                     ;RETURN WITH CHAR
    2196/     AE6 :                     ;
    2197/     AE6 : DB 11               CHKIO:  IN   UARTC              ;*** CHKIO ***
    2198/     AE8 : E6 02                       ANI  2H                 ;MASK STATUS BIT
    2199/     AEA : C8                          RZ                      ;NOT READY, RETURN "Z"
    2200/     AEB : DB 10                       IN   UARTD              ;READY, READ DATA
    2201/     AED : FE 03               CI1:    CPI  3H                 ;IS IT CONTROL-C?
    2202/     AEF : C0                          RNZ                     ;NO, RETURN "NZ"
    2203/     AF0 : C3 2A 01                    JMP  CTRLC              ;YES, RESTART TBI
