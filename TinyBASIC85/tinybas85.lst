    1446/     751 : C9                          RET
    1447/     752 :                     ;
    1448/     752 :                     ;*************************************************************
    1449/     752 :                     ;
    1450/     752 :                     ; *** DIVIDE *** SUBDE *** CHKSGN *** CHGSGN *** & CKHLDE ***
    1451/     752 :                     ;
    1452/     752 :                     ; 'DIVIDE' DIVIDES HL BY DE, RESULT IN BC, REMAINDER IN HL
    1453/     752 :                     ;
    1454/     752 :                     ; 'SUBDE' SUBSTRACTS DE FROM HL
    1455/     752 :                     ;
    1456/     752 :                     ; 'CHKSGN' CHECKS SIGN OF HL.  IF +, NO CHANGE.  IF -, CHANGE
    1457/     752 :                     ; SIGN AND FLIP SIGN OF B.
    1458/     752 :                     ;
    1459/     752 :                     ; 'CHGSGN' CHANGES SIGN OF HL AND B UNCONDITIONALLY.
    1460/     752 :                     ;
    1461/     752 :                     ; 'CKHLDE' CHECKS SIGN OF HL AND DE.  IF DIFFERENT, HL AND DE
    1462/     752 :                     ; ARE INTERCHANGED.  IF SAME SIGN, NOT INTERCHANGED.  EITHER
    1463/     752 :                     ; CASE, HL DE ARE THEN COMPARED TO SET THE FLAGS.
    1464/     752 :                     ;
    1465/     752 : E5                  DIVIDE: PUSH H                  ;*** DIVIDE ***
    1466/     753 : 6C                          MOV  L,H                ;DIVIDE H BY DE
    1467/     754 : 26 00                       MVI  H,0
    1468/     756 : CD 5D 07                    CALL DV1
    1469/     759 : 41                          MOV  B,C                ;SAVE RESULT IN B
    1470/     75A : 7D                          MOV  A,L                ;(REMINDER+L)/DE
    1471/     75B : E1                          POP  H
    1472/     75C : 67                          MOV  H,A
    1473/     75D : 0E FF               DV1:    MVI  C,0FFH             ;RESULT IN C
    1474/     75F : 0C                  DV2:    INR  C                  ;DUMB ROUTINE
    1475/     760 : CD 68 07                    CALL SUBDE              ;DIVIDE BY SUBTRACT
    1476/     763 : D2 5F 07                    JNC  DV2                ;AND COUNT
    1477/     766 : 19                          DAD  D
    1478/     767 : C9                          RET
    1479/     768 :                     ;
    1480/     768 : 7D                  SUBDE:  MOV  A,L                ;*** SUBDE ***
    1481/     769 : 93                          SUB  E                  ;SUBSTRACT DE FROM
    1482/     76A : 6F                          MOV  L,A                ;HL
    1483/     76B : 7C                          MOV  A,H
    1484/     76C : 9A                          SBB  D
    1485/     76D : 67                          MOV  H,A
    1486/     76E : C9                          RET
    1487/     76F :                     ;
    1488/     76F : 7C                  CHKSGN: MOV  A,H                ;*** CHKSGN ***
    1489/     770 : B7                          ORA  A                  ;CHECK SIGN OF HL
    1490/     771 : F0                          RP                      ;IF -, CHANGE SIGN
    1491/     772 : 3A 03 80                    LDA  USIGNF             ;IF UNSIGNED
    1492/     775 : B7                          ORA  A                  ;OPERATION
    1493/     776 : C0                          RNZ                     ;DON'T FLIP SIGN
    1494/     777 :                     ;
    1495/     777 : 7C                  CHGSGN: MOV  A,H                ;*** CHGSGN ***
    1496/     778 : 2F                          CMA                     ;CHANGE SIGN OF HL
    1497/     779 : 67                          MOV  H,A
    1498/     77A : 7D                          MOV  A,L
    1499/     77B : 2F                          CMA
    1500/     77C : 6F                          MOV  L,A
    1501/     77D : 23                          INX  H
    1502/     77E : 78                          MOV  A,B                ;AND ALSO FLIP B
    1503/     77F : EE 80                       XRI  80H
    1504/     781 : 47                          MOV  B,A
    1505/     782 : C9                          RET
    1506/     783 :                     ;
    1507/     783 : 7C                  CKHLDE: MOV  A,H
    1508/     784 : AA                          XRA  D                  ;SAME SIGN?
    1509/     785 : F2 90 07                    JP   CK1                ;YES, COMPARE
    1510/     788 : 3A 03 80                    LDA  USIGNF             ;IF UNSIGNED
    1511/     78B : B7                          ORA  A                  ;OPERATION
    1512/     78C : C2 90 07                    JNZ  CK1                ;DON'T EXCHG
    1513/     78F : EB                          XCHG                    ;NO, XCH AND COMP
    1514/     790 : E7                  CK1:    RST  4
    1515/     791 : C9                          RET
    1516/     792 :                     ;
    1517/     792 :                     ;*************************************************************
    1518/     792 :                     ;
    1519/     792 :                     ; *** SETVAL *** FIN *** ENDCHK *** & ERROR (& FRIENDS) ***
    1520/     792 :                     ;
    1521/     792 :                     ; "SETVAL" EXPECTS A VARIABLE, FOLLOWED BY AN EQUAL SIGN AND
    1522/     792 :                     ; THEN AN EXPR.  IT EVALUATES THE EXPR. AND SET THE VARIABLE
    1523/     792 :                     ; TO THAT VALUE.
    1524/     792 :                     ;
    1525/     792 :                     ; "FIN" CHECKS THE END OF A COMMAND.  IF IT ENDED WITH ":",
    1526/     792 :                     ; EXECUTION CONTINUES.  IF IT ENDED WITH A CR, IT FINDS THE
    1527/     792 :                     ; NEXT LINE AND CONTINUE FROM THERE.
    1528/     792 :                     ;
    1529/     792 :                     ; "ENDCHK" CHECKS IF A COMMAND IS ENDED WITH CR.  THIS IS
    1530/     792 :                     ; REQUIRED IN CERTAIN COMMANDS.  (GOTO, RETURN, AND STOP ETC.)
    1531/     792 :                     ;
    1532/     792 :                     ; "ERROR" PRINTS THE STRING POINTED BY DE (AND ENDS WITH CR).
    1533/     792 :                     ; IT THEN PRINTS THE LINE POINTED BY 'CURRNT' WITH A "?"
    1534/     792 :                     ; INSERTED AT WHERE THE OLD TEXT POINTER (SHOULD BE ON TOP
    1535/     792 :                     ; OF THE STACK) POINTS TO.  EXECUTION OF TB IS STOPPED
    1536/     792 :                     ; AND TBI IS RESTARTED.  HOWEVER, IF 'CURRNT' -> ZERO
    1537/     792 :                     ; (INDICATING A DIRECT COMMAND), THE DIRECT COMMAND IS NOT
    1538/     792 :                     ; PRINTED.  AND IF 'CURRNT' -> NEGATIVE # (INDICATING 'INPUT'
    1539/     792 :                     ; COMMAND), THE INPUT LINE IS NOT PRINTED AND EXECUTION IS
    1540/     792 :                     ; NOT TERMINATED BUT CONTINUED AT 'INPERR'.
    1541/     792 :                     ;
    1542/     792 :                     ; RELATED TO 'ERROR' ARE THE FOLLOWING:
    1543/     792 :                     ; 'QWHAT' SAVES TEXT POINTER IN STACK AND GET MESSAGE "WHAT?"
    1544/     792 :                     ; 'AWHAT' ASSUMES THAT TEXT PTR IS ALREADY PUSHED TO STACK BY
    1545/     792 :                     ; WHATEVER CODE THAT EXECUTED IMMEDIATELY PRIOR ERROR OCCURRED.
    1546/     792 :                     ; 'QSORRY' AND 'ASORRY' DO SAME KIND OF THING.
    1547/     792 :                     ; 'AHOW' AND 'AHOW' IN THE ZERO PAGE SECTION ALSO DO THIS.
    1548/     792 :                     ; ALL THE WHATS, HOWS AND SORRYS SHALL BE ACCESSED USING A
    1549/     792 :                     ; SUBROUTINE CALL INSTEAD OF OLD VERSIONS OF TBI USING JUMP.
    1550/     792 :                     ; 'ERRADR' RETREIVES CALL ADDRESS OF THE ASSEMBLY INSTRUCTION
    1551/     792 :                     ; THAT CAUSED ERROR AND PRINTS THE LINE NUMBER AS HEXADECIMAL.
    1552/     792 :                     ;
    1553/     792 : CD 4D 00            SETVAL: CALL TSTV               ;*** SETVAL ***
    1554/     795 : DC C6 07                    CC   QWHAT              ;"WHAT?" NO VARIABLE
    1555/     798 : E5                          PUSH H                  ;SAVE ADDRESS OF VAR.
    1556/     799 : CF                          RST  1                  ;PASS "=" SIGN
    1557/     79A : 3D                          DB   '='
    1558/     79B : 08                          DB   SV1-$-1
    1559/     79C : DF                          RST  3                  ;EVALUATE EXPR.
    1560/     79D : 44                          MOV  B,H                ;VALUE IS IN BC NOW
    1561/     79E : 4D                          MOV  C,L
    1562/     79F : E1                          POP  H                  ;GET ADDRESS
    1563/     7A0 : 71                          MOV  M,C                ;SAVE VALUE
    1564/     7A1 : 23                          INX  H
    1565/     7A2 : 70                          MOV  M,B
    1566/     7A3 : C9                          RET
    1567/     7A4 : CD C6 07            SV1:    CALL QWHAT              ;NO "=" SIGN
    1568/     7A7 :                     ;
    1569/     7A7 : CF                  FIN:    RST  1                  ;*** FIN ***
    1570/     7A8 : 3A                          DB   ':'
    1571/     7A9 : 04                          DB   FI1-$-1
    1572/     7AA : F1                          POP  PSW                ;":", PURGE RET. ADDR.
    1573/     7AB : C3 C6 01                    JMP  RUNSML             ;CONTINUE SAME LINE
    1574/     7AE : CF                  FI1:    RST  1                  ;NOT ":", IS IT CR?
    1575/     7AF : 0D                          DB   CR
    1576/     7B0 : 04                          DB   FI2-$-1
    1577/     7B1 : F1                          POP  PSW                ;YES, PURGE RET. ADDR.
    1578/     7B2 : C3 B6 01                    JMP  RUNNXL             ;RUN NEXT LINE
    1579/     7B5 : C9                  FI2:    RET                     ;ELSE RETURN TO CALLER
    1580/     7B6 :                     ;
    1581/     7B6 : EF                  ENDCHK: RST  5                  ;*** ENDCHK ***
    1582/     7B7 : FE 0D                       CPI  CR                 ;END WITH CR?
    1583/     7B9 : C8                          RZ                      ;OK, ELSE SAY: "WHAT?"
    1584/     7BA : CD C6 07                    CALL QWHAT
    1585/     7BD :                     ;
    1586/     7BD : EF                  SKPCOM: RST  5                  ;*** SKPCOM ***
    1587/     7BE : FE 2C                       CPI  ','                ;NEXT NON BLANK MAY BE COMMA
    1588/     7C0 : C0                          RNZ                     ;IF NOT JUST RETURN, ELSE
    1589/     7C1 : 13                          INX  D                  ;SKIP TO NEXT CHAR IN BUF
    1590/     7C2 : C9                          RET
    1591/     7C3 :                     ;                               ;*** AWHAT ***
    1592/     7C3 : E1                  AWHAT:  POP  H                  ; PC TO HL,(DE)IS TOP OF STK
    1593/     7C4 : E3                          XTHL                    ;(DE)TO HL, PC BACK ON STACK
    1594/     7C5 : EB                          XCHG                    ;(DE)IS BACK IN DE, HL JUNK
    1595/     7C6 : D5                  QWHAT:  PUSH D                  ;*** QWHAT ***
    1596/     7C7 : 11 0C 01                    LXI  D,WHAT
    1597/     7CA : 3E 0D               ERROR:  MVI  A,CR               ;*** ERROR ***
    1598/     7CC : CD 21 09                    CALL PRTSTG             ;PRINT 'WHAT?', 'HOW?'
    1599/     7CF : D1                          POP  D                  ;OR 'SORRY'
    1600/     7D0 :                     ;                               ;*** ERRADR ***
    1601/     7D0 : E1                          POP  H                  ;GET CALLERS ADDR TO HL
    1602/     7D1 : 2B                          DCX  H                  ;WE WANT ADDRESS
    1603/     7D2 : 2B                          DCX  H                  ;OF THE CALL OPERAND
    1604/     7D3 : 2B                          DCX  H                  ;DIFF IS THREE BYTES
    1605/     7D4 : 3E 5B                       MVI  A,'['              ;PRINT OPENING BRACE
    1606/     7D6 : D7                          RST  2                  ;FOR READABILIY
    1607/     7D7 : CD D3 09                    CALL PRTWD              ;PRINT THE ADDRESS
    1608/     7DA : 3E 5D                       MVI  A,']'              ;PRINT CLOSING BRACE
    1609/     7DC : D7                          RST  2                  ;AROUND ADDRESS
    1610/     7DD : 3E 0D                       MVI  A,CR               ;END WITH A CR+LF
    1611/     7DF : D7                          RST  2                  ;AND CONTINUE ERR HANDLER
    1612/     7E0 :                     ;
    1613/     7E0 : 1A                          LDAX D                  ;SAVE THE CHARACTER
    1614/     7E1 : F5                          PUSH PSW                ;AT WHERE OLD DE ->
    1615/     7E2 : 97                          SUB  A                  ;AND PUT A 0 THERE
    1616/     7E3 : 12                          STAX D
    1617/     7E4 : 2A 06 80                    LHLD CURRNT             ;GET CURRENT LINE #
    1618/     7E7 : E5                          PUSH H
    1619/     7E8 : 7E                          MOV  A,M                ;CHECK THE VALUE
    1620/     7E9 : 23                          INX  H
    1621/     7EA : B6                          ORA  M
    1622/     7EB : CA 04 08                    JZ   ERR1               ;IF ZERO IT'S DIRECT MODE
    1623/     7EE : D1                          POP  D                  ;DE -> CURRENT LINE
    1624/     7EF : 7E                          MOV  A,M                ;IF NEGATIVE,
    1625/     7F0 : B7                          ORA  A
    1626/     7F1 : FA 85 04                    JM   INPERR             ;REDO INPUT
    1627/     7F4 : CD AB 09                    CALL PRTLN              ;ELSE PRINT THE LINE
    1628/     7F7 : 1B                          DCX  D                  ;UPTO WHERE THE 0 IS
    1629/     7F8 : F1                          POP  PSW                ;RESTORE THE CHARACTER
    1630/     7F9 : 12                          STAX D
    1631/     7FA : 3E 3F                       MVI  A,'?'              ;PRINT A "?"
    1632/     7FC : D7                          RST  2
    1633/     7FD : 97                          SUB  A                  ;AND THE REST OF THE
    1634/     7FE : CD 21 09                    CALL PRTSTG             ;LINE
    1635/     801 : C3 2D 01                    JMP  RSTART             ;THEN RESTART
    1636/     804 : E1                  ERR1:   POP  H
    1637/     805 : F1                          POP  PSW                ;RESTORE THE CHARACTER
    1638/     806 : 12                          STAX D                  ;WHERE THE NULL WAS PUT
    1639/     807 : C3 2D 01                    JMP  RSTART
    1640/     80A :                     ;                               ;*** ASORRY ***
    1641/     80A : E1                  ASORRY: POP  H                  ; PC TO HL,(DE)IS TOP OF STK
    1642/     80B : E3                          XTHL                    ;(DE)TO HL, PC BACK ON STACK
    1643/     80C : EB                          XCHG                    ;(DE)IS BACK IN DE, HL JUNK
    1644/     80D : D5                  QSORRY: PUSH D                  ;*** QSORRY ***
    1645/     80E : 11 13 01                    LXI  D,SORRY
    1646/     811 : C3 CA 07                    JMP  ERROR
    1647/     814 :                     ;
    1648/     814 :                     ;*************************************************************
    1649/     814 :                     ;
    1650/     814 :                     ; *** GETLN *** FNDLN (& FRIENDS) ***
    1651/     814 :                     ;
    1652/     814 :                     ; 'GETLN' READS A INPUT LINE INTO 'BUFFER'.  IT FIRST PROMPT
    1653/     814 :                     ; THE CHARACTER IN A (GIVEN BY THE CALLER), THEN IT FILLS
    1654/     814 :                     ; THE BUFFER AND ECHOS.  IT IGNORES LF'S AND NULLS, BUT STILL
    1655/     814 :                     ; ECHOS THEM BACK.  BACKSPACE IS USED TO CAUSE IT TO DELETE
    1656/     814 :                     ; THE LAST CHARACTER (IF THERE IS ONE).
    1657/     814 :                     ; CR SIGNALS THE END OF A LINE, AND CAUSE 'GETLN' TO RETURN.
    1658/     814 :                     ;
    1659/     814 :                     ; 'FNDLN' FINDS A LINE WITH A GIVEN LINE # (IN HL) IN THE
    1660/     814 :                     ; TEXT SAVE AREA.  DE IS USED AS THE TEXT POINTER.  IF THE
    1661/     814 :                     ; LINE IS FOUND, DE WILL POINT TO THE BEGINNING OF THAT LINE
    1662/     814 :                     ; (I.E., THE LOW BYTE OF THE LINE #), AND FLAGS ARE NC & Z.
    1663/     814 :                     ; IF THAT LINE IS NOT THERE AND A LINE WITH A HIGHER LINE #
    1664/     814 :                     ; IS FOUND, DE POINTS TO THERE AND FLAGS ARE NC & NZ.  IF
    1665/     814 :                     ; WE REACHED THE END OF TEXT SAVE AREA AND CANNOT FIND THE
    1666/     814 :                     ; LINE, FLAGS ARE C & NZ.
    1667/     814 :                     ; 'FNDLN' WILL INITIALIZE DE TO THE BEGINNING OF THE TEXT SAVE
    1668/     814 :                     ; AREA TO START THE SEARCH.  SOME OTHER ENTRIES OF THIS
    1669/     814 :                     ; ROUTINE WILL NOT INITIALIZE DE AND DO THE SEARCH.
    1670/     814 :                     ; 'FNDLNP' WILL START WITH DE AND SEARCH FOR THE LINE #.
    1671/     814 :                     ; 'FNDNXT' WILL BUMP DE BY 2, FIND A CR AND THEN START SEARCH.
    1672/     814 :                     ; 'FNDSKP' USE DE TO FIND A CR, AND THEN START SEARCH.
    1673/     814 :                     ;
    1674/     814 :                     ; Insert  ESC[1~
    1675/     814 :                     ; Home    ESC[2~
    1676/     814 :                     ; PgUp    ESC[3~
    1677/     814 :                     ; Delete  ESC[4~
    1678/     814 :                     ; End     ESC[5~
    1679/     814 :                     ; PgDn    ESC[6~
    1680/     814 :                     ; Arrow U ESC[A
    1681/     814 :                     ; Arrow D ESC[B
    1682/     814 :                     ; Arrow R ESC[C
    1683/     814 :                     ; Arrow L ESC[D
    1684/     814 :                     ;
    1685/     814 : D7                  GETLN:  RST  2                  ;*** GETLN ***
    1686/     815 : 11 36 BF                    LXI  D,BUFFER           ;PROMPT AND INIT.
    1687/     818 : 42                  EDITLN: MOV  B,D                ;USE (BC) AS INSERT PTR
    1688/     819 : 4B                          MOV  C,E                ;AND (DE) AS LENGTH PTR
    1689/     81A : CD DF 0A            GL1:    CALL INCHR              ;WAIT FOR CHR RCVD
    1690/     81D : FE 0D                       CPI  CR                 ;WAS IT CR?
    1691/     81F : C2 26 08                    JNZ  GL2                ;NO, CHECK WHAT ELSE
    1692/     822 : D7                          RST  2                  ;ECHO CR AND AUTO LF
    1693/     823 : 12                          STAX D                  ;SAVE CR AT BUF.END
    1694/     824 : 13                          INX  D                  ;AND BUMP POINTER
    1695/     825 : C9                          RET                     ;END OF LINE
    1696/     826 : FE 08               GL2:    CPI  BS                 ;DELETE LAST CHARACTER?
    1697/     828 : C2 33 08                    JNZ  GL3                ;NO, CHECK WHAT ELSE
    1698/     82B : E5                          PUSH H                  ;DUMMY SAVE HL
    1699/     82C : 21 1A 08                    LXI  H,GL1              ;GET DESIRED RETURN ADDR
    1700/     82F : E3                          XTHL                    ;PUT IT ON STACK
    1701/     830 : C3 D0 08                    JMP  BACKSP             ;DO BACKSPACE
    1702/     833 : FE 1B               GL3:    CPI  ESC                ;ESCAPE SEQ?
    1703/     835 : C2 68 08                    JNZ  GL4                ;NO, CHECK WHAT ELSE
    1704/     838 : CD DF 0A                    CALL INCHR              ;GET NEXT CHAR IN ESC SEQ.
    1705/     83B : FE 5B                       CPI  '['                ;SHOULD BE [
    1706/     83D : C2 6D 08                    JNZ  GL5                ;ELSE GO ON AND ECHO
    1707/     840 : E5                          PUSH H                  ;DUMMY SAVE HL
    1708/     841 : 21 1A 08                    LXI  H,GL1              ;GET DESIRED RETURN ADDR
    1709/     844 : E3                          XTHL                    ;PUT IT ON STACK
    1710/     845 : CD DF 0A                    CALL INCHR              ;GET NEXT CHAR
    1711/     848 : FE 44                       CPI  'D'                ;LEFT ARROW?
    1712/     84A : CA AC 08                    JZ   ALEFT              ;JMP AND RETURN TO GL1
    1713/     84D : FE 43                       CPI  'C'                ;RIGHT ARROW?
    1714/     84F : CA B6 08                    JZ   ARIGHT             ;JMP AND RETURN TO GL1
    1715/     852 : FE 42                       CPI  'B'                ;DOWN ARROW?
    1716/     854 : CA BE 08                    JZ   AUPDN              ;JMP AND RETURN TO GL1
    1717/     857 : FE 41                       CPI  'A'                ;UP ARROW?
    1718/     859 : CA BE 08                    JZ   AUPDN              ;JMP AND RETURN TO GL1
    1719/     85C : FE 34                       CPI  '4'                ;POSSIBLE DELETE KEY?
    1720/     85E : C0                          RNZ                     ;IF NOT RETURN TO GL1
    1721/     85F : CD DF 0A                    CALL INCHR              ;GET NEXT CHAR
    1722/     862 : FE 7E                       CPI  '~'                ;SHOULD BE ~ FOR DELETE
    1723/     864 : C0                          RNZ                     ;IF NOT RETURN TO GL1
    1724/     865 : C3 D7 08                    JMP  DELETE             ;JMP AND RETURN TO GL1
    1725/     868 : FE 20               GL4:    CPI  ' '                ;CHECK IF PRINTABLE CHAR
    1726/     86A : DA 1A 08                    JC   GL1                ;IF NOT GO BACK
    1727/     86D : FE 61               GL5:    CPI  'a'                ;CHECK IF LOWER CASE
    1728/     86F : DA 79 08                    JC   INSERT             ;IT WAS BELOW ASCII 'a'
    1729/     872 : FE 7B                       CPI  'z'+1              ;CHARACTERS a TO z
    1730/     874 : D2 79 08                    JNC  INSERT             ;IT WAS ABOVE ASCII 'z'
