    2329/     BEA :                     TAB8:                           ;RELATION OPERATORS
    2330/     BEA : 3E 3D                       DB   ">="
    2331/     BEC : (MACRO)                     DWA  ROP1
    2331/     BEC : 84                          DB   (ROP1 >> 8) + 128
    2331/     BED : F6                          DB   ROP1 & 0FFH
    2332/     BEE : 21 3D                       DB   "!="
    2333/     BF0 : (MACRO)                     DWA  ROP2
    2333/     BF0 : 84                          DB   (ROP2 >> 8) + 128
    2333/     BF1 : FC                          DB   ROP2 & 0FFH
    2334/     BF2 : 3E                          DB   ">"
    2335/     BF3 : (MACRO)                     DWA  ROP3
    2335/     BF3 : 85                          DB   (ROP3 >> 8) + 128
    2335/     BF4 : 02                          DB   ROP3 & 0FFH
    2336/     BF5 : 3C 3D                       DB   "<="
    2337/     BF7 : (MACRO)                     DWA  ROP4
    2337/     BF7 : 85                          DB   (ROP4 >> 8) + 128
    2337/     BF8 : 09                          DB   ROP4 & 0FFH
    2338/     BF9 : 3D 3D                       DB   "=="
    2339/     BFB : (MACRO)                     DWA  ROP5
    2339/     BFB : 85                          DB   (ROP5 >> 8) + 128
    2339/     BFC : 11                          DB   ROP5 & 0FFH
    2340/     BFD : 3C                          DB   "<"
    2341/     BFE : (MACRO)                     DWA  ROP6
    2341/     BFE : 85                          DB   (ROP6 >> 8) + 128
    2341/     BFF : 17                          DB   ROP6 & 0FFH
    2342/     C00 : (MACRO)                     DWA  ROP7
    2342/     C00 : 85                          DB   (ROP7 >> 8) + 128
    2342/     C01 : 1D                          DB   ROP7 & 0FFH
    2343/     C02 :                     ;
    2344/     C02 :                     TAB9:                           ;SHIFT OPERATORS
    2345/     C02 : 3C 3C                       DB   "<<"
    2346/     C04 : (MACRO)                     DWA  XP11
    2346/     C04 : 85                          DB   (XP11 >> 8) + 128
    2346/     C05 : 7B                          DB   XP11 & 0FFH
    2347/     C06 : 3E 3E                       DB   ">>"
    2348/     C08 : (MACRO)                     DWA  XP12
    2348/     C08 : 85                          DB   (XP12 >> 8) + 128
    2348/     C09 : 85                          DB   XP12 & 0FFH
    2349/     C0A : (MACRO)                     DWA  XP13
    2349/     C0A : 85                          DB   (XP13 >> 8) + 128
    2349/     C0B : 8F                          DB   XP13 & 0FFH
    2350/     C0C :                     ;
    2351/     C0C :                     TAB10:                          ;FOR AUTORUN DETECT
    2352/     C0C : 41 55 54 4F 52 55           DB   "AUTORUN"
                    4E 
    2353/     C13 : (MACRO)                     DWA  RUN
    2353/     C13 : 81                          DB   (RUN >> 8) + 128
    2353/     C14 : AC                          DB   RUN & 0FFH
    2354/     C15 : (MACRO)                     DWA  CONT
    2354/     C15 : 8A                          DB   (CONT >> 8) + 128
    2354/     C16 : B1                          DB   CONT & 0FFH
    2355/     C17 :                     ;
    2356/     C17 : 21 F2 0A            DIRECT: LXI  H,TAB1-1           ;*** DIRECT ***
    2357/     C1A :                     ;
    2358/     C1A :                     EXEC:                           ;*** EXEC ***
    2359/     C1A : EF                  EX0:    RST  5                  ;IGNORE LEADING BLANKS
    2360/     C1B : D5                          PUSH D                  ;SAVE POINTER
    2361/     C1C : 1A                  EX1:    LDAX D                  ;GET CAHACTER TO
    2362/     C1D : 13                          INX  D                  ;COMPARE FROM BUFFER
    2363/     C1E : 23                          INX  H                  ;HL->TABLE
    2364/     C1F : BE                          CMP  M                  ;IF MATCH, TEST NEXT
    2365/     C20 : CA 1C 0C                    JZ   EX1
    2366/     C23 : 3E 7F                       MVI  A,07FH             ;ELSE SEE IF BIT 7
    2367/     C25 : 1B                          DCX  D                  ;OF TABLE IS SET, WHICH
    2368/     C26 : BE                          CMP  M                  ;IS THE JUMP ADDR. (HI)
    2369/     C27 : DA 34 0C                    JC   EX5                ;C:YES, MATCHED
    2370/     C2A : 23                  EX2:    INX  H                  ;NC:NO, FIND JUMP ADDR.
    2371/     C2B : BE                          CMP  M
    2372/     C2C : D2 2A 0C                    JNC  EX2
    2373/     C2F : 23                          INX  H                  ;BUMP TO NEXT TAB. ITEM
    2374/     C30 : D1                          POP  D                  ;RESTORE STRING POINTER
    2375/     C31 : C3 1A 0C                    JMP  EX0                ;TEST AGAINST NEXT ITEM
    2376/     C34 : 7E                  EX5:    MOV  A,M                ;LOAD HL WITH THE JUMP
    2377/     C35 : 23                          INX  H                  ;ADDRESS FROM THE TABLE
    2378/     C36 : 6E                          MOV  L,M
    2379/     C37 : E6 7F                       ANI  7FH                ;MASK OFF BIT 7
    2380/     C39 : 67                          MOV  H,A
    2381/     C3A : F1                          POP  PSW                ;CLEAN UP THE GABAGE
    2382/     C3B : E9                          PCHL                    ;AND WE GO DO IT
    2383/     C3C :                     ;
    2384/     C3C :                     ;*************************************************************
    2385/     C3C :                     ;
    2386/     C3C :                     ; *** SPI IMPLEMENTATION USING SID/SOD AND IO WRITE AS CLK ***
    2387/     C3C :                     ;
    2388/     C3C :                     ; SDOUT AND SDIN ARE SOFTWARE DRIVVEN SERIAL OUTPUT AND INPUT
    2389/     C3C :                     ; FUNCTIONS USING 8085 PINS SOD AND SID FOR DATA TRANSFER AND
    2390/     C3C :                     ; A DUMMY I/O WRITE TO GENERATE CLOCK PULSE. SERIAL DATA OUTPUT
    2391/     C3C :                     ; FREQUENCY IS ABOUT 64KBIT WHEN INCLUDING CALL AND RETURN
    2392/     C3C :                     ; YIELDS A CHARACTER BACK TO BACK TIME OF ABOUT 140 MICROSEC.
    2393/     C3C :                     ; SERIAL DATA INPUT IS SLIGHTLY FASTER. CLK PULSE IS GENERATED
    2394/     C3C :                     ; BY A DUMMY WRITE TO I/O ADDR WHERE THE CHIP SELECT IS NOR'D
    2395/     C3C :                     ; WITH THE WR STROBE TO GENERATE A 460 NANOSEC POSITIVE PULSE.
    2396/     C3C :                     ; CLOCK PULSE IS PROLONGED TO 1700 NANOSEC BY R/C AND LOGIC.
    2397/     C3C :                     ;
    2398/     C3C : C5                  SDOUT:  PUSH B                  ;SAVE VALUES IN
    2399/     C3D : D5                          PUSH D                  ;WORKING REGISTERS
    2400/     C3E : 11 40 80                    LXI  D,8040H            ;AND & OR MASK IN DE
    2401/     C41 : 0E 08                       MVI  C,8H               ;NUMBER OF BITS
    2402/     C43 : 47                          MOV  B,A                ;STORE BYTE IN B
    2403/     C44 : A2                  SDO1:   ANA  D                  ;MASK THE CURRENT BIT
    2404/     C45 : B3                          ORA  E                  ;SET BIT FOR SOD ENABLE
    2405/     C46 : 30                          SIM                     ;WRITE IT TO PIN
    2406/     C47 : 78                          MOV  A,B                ;RESTORE BYTE
    2407/     C48 : 07                          RLC                     ;ROTATE ONE STEP
    2408/     C49 : 47                          MOV  B,A                ;AND SAVE IT
    2409/     C4A : D3 20                       OUT  SPICLK             ;ISSUE A CLOCK PULSE
    2410/     C4C : 0D                          DCR  C                  ;COUNT ITERATIONS
    2411/     C4D : C2 44 0C                    JNZ  SDO1               ;LOOP IF NOT READY
    2412/     C50 : 7B                          MOV  A,E                ;FINISH WITH A '0'
    2413/     C51 : 30                          SIM                     ;WRITE TO PIN
    2414/     C52 : 78                          MOV  A,B                ;RESTORE BYTE
    2415/     C53 : D1                          POP  D
    2416/     C54 : C1                          POP  B
    2417/     C55 : C9                          RET                     ;AND WE'RE DONE
    2418/     C56 :                     ;
    2419/     C56 : C5                  SDIN:   PUSH B                  ;SAVE VALUES IN
    2420/     C57 : D5                          PUSH D                  ;WORKING REGISTERS
    2421/     C58 : 16 80                       MVI  D,80H              ;AND MASK IN D
    2422/     C5A : 01 08 00                    LXI  B,0008H            ;TMP STORE & NBR OF BITS
    2423/     C5D : 20                  SDI1:   RIM                     ;READ CURRRENT BIT
    2424/     C5E : D3 20                       OUT  SPICLK             ;ISSUE A CLOCK PULSE
    2425/     C60 : A2                          ANA  D                  ;MASK THE CURRENT BIT
    2426/     C61 : B0                          ORA  B                  ;MERGE WITH PREVIOUS
    2427/     C62 : 07                          RLC                     ;ROTATE ONE STEP
    2428/     C63 : 47                          MOV  B,A                ;AND SAVE IT
    2429/     C64 : 0D                          DCR  C                  ;COUNT ITERATIONS
    2430/     C65 : C2 5D 0C                    JNZ  SDI1               ;LOOP IF NOT READY
    2431/     C68 : D1                          POP  D
    2432/     C69 : C1                          POP  B
    2433/     C6A : C9                          RET                     ;AND WE'RE DONE
    2434/     C6B :                     ;
    2435/     C6B :                     ;*************************************************************
    2436/     C6B :                     ;
    2437/     C6B :                     ; *** SPI EEPROM DRIVER ***
    2438/     C6B :                     ;
    2439/     C6B :                     ; ARGUMENTS: EEPROM START ADR [BC], LENGTH [DE], MEM DATAPTR [HL]
    2440/     C6B :                     ;
    2441/     C6B : 3E 17               CSLOW:  MVI  A,UENABL+UDTR      ;** SELECT EEPROM **
    2442/     C6D : D3 11                       OUT  UARTC              ;WRITE TO PORT
    2443/     C6F : C9                          RET
    2444/     C70 :                     ;
    2445/     C70 : F5                  CSHIGH: PUSH PSW                ;** DESELECT EEPROM **
    2446/     C71 : 3E 15                       MVI  A,UENABL           ;MUST SAVE ACKUMULATOR
    2447/     C73 : D3 11                       OUT  UARTC              ;WHILE SETTING OUTPUT
    2448/     C75 : F1                          POP  PSW                ;RESTORE ACKUMULATOR
    2449/     C76 : C9                          RET
    2450/     C77 :                     ;
    2451/     C77 : 01 80 00            CHKWIP: LXI  B,128              ;** WRITE IN PROGRESS **
    2452/     C7A : CD 6B 0C            CHKW1:  CALL CSLOW              ;SELECT EEPROM
    2453/     C7D : 3E 05                       MVI  A,EERDSR           ;OPCODE READ STATUS
    2454/     C7F : CD 3C 0C                    CALL SDOUT              ;TRANSMIT OPCODE
    2455/     C82 : CD 56 0C                    CALL SDIN               ;READ STATUS
    2456/     C85 : CD 70 0C                    CALL CSHIGH             ;DESELECT
    2457/     C88 : E6 01                       ANI  EEWIPB             ;MASK THE BIT
    2458/     C8A : C8                          RZ                      ;ZERO MEANS READY
    2459/     C8B : 0B                          DCX  B                  ;ELSE COUNT LOOPS
    2460/     C8C : (MACRO)                     JNK  CHKW1              ;AND READ AGAIN
    2460/     C8C : DD                          DB    0DDH
    2460/     C8D : 7A                          DB    (CHKW1 & 0FFH)
    2460/     C8E : 0C                          DB    (CHKW1 >> 8)
    2461/     C8F : CD 0A 08                    CALL ASORRY             ;EEPROM NEVER GOT READY
    2462/     C92 :                     ;
    2463/     C92 : 7A                  EERD:   MOV  A,D                ;** READ EEPROM **
    2464/     C93 : B3                          ORA  E                  ;CHECK FOR ZERO LENGTH
    2465/     C94 : C8                          RZ                      ;SKIP IF SO
    2466/     C95 : C5                          PUSH B                  ;SAVE START ADDR (BC)
    2467/     C96 : CD 77 0C                    CALL CHKWIP             ;DURING WR.IN.PROGRESS
    2468/     C99 : C1                          POP  B                  ;RESTORE IT
    2469/     C9A : CD 6B 0C                    CALL CSLOW              ;SELECT EEPROM
    2470/     C9D : 3E 03                       MVI  A,EERDDA           ;OPCODE READ DATA
    2471/     C9F : CD 3C 0C                    CALL SDOUT              ;TRANSMIT OPCODE
    2472/     CA2 : 78                          MOV  A,B                ;GET ADDRESS HIGH BYTE
    2473/     CA3 : CD 3C 0C                    CALL SDOUT              ;TRANSMIT
    2474/     CA6 : 79                          MOV  A,C                ;GET ADDRESS LOW BYTE
    2475/     CA7 : CD 3C 0C                    CALL SDOUT              ;TRANSMIT
    2476/     CAA : 1B                  EERD1:  DCX  D                  ;DECREMENT LENGTH
    2477/     CAB : (MACRO)                     JK   EERD2              ;FINISH WHEN UNDERFLOW
    2477/     CAB : FD                          DB    0FDH
    2477/     CAC : B6                          DB    (EERD2 & 0FFH)
    2477/     CAD : 0C                          DB    (EERD2 >> 8)
    2478/     CAE : CD 56 0C                    CALL SDIN               ;READ ONE BYTE
    2479/     CB1 : 77                          MOV  M,A                ;STORE IN RAM
    2480/     CB2 : 23                          INX  H                  ;BUMP RAM POINTER
    2481/     CB3 : C3 AA 0C                    JMP  EERD1              ;AND LOOP
    2482/     CB6 : CD 70 0C            EERD2:  CALL CSHIGH             ;END OF READ SESSION
    2483/     CB9 : C9                          RET
    2484/     CBA :                     ;
    2485/     CBA : 7A                  EEWRPG: MOV  A,D                ;** WRITE PAGE EEPROM **
    2486/     CBB : B3                          ORA  E                  ;CHECK FOR ZERO LENGTH
    2487/     CBC : C8                          RZ                      ;SKIP IF SO
    2488/     CBD : C5                          PUSH B                  ;SAVE START ADDR (BC)
    2489/     CBE : CD 77 0C                    CALL CHKWIP             ;DURING WR.IN.PROGRESS
    2490/     CC1 : C1                          POP  B                  ;RESTORE IT
    2491/     CC2 : CD 6B 0C                    CALL CSLOW              ;SELECT EEPROM
    2492/     CC5 : 3E 06                       MVI  A,EEWREN           ;OPCODE WRITE ENABLE
    2493/     CC7 : CD 3C 0C                    CALL SDOUT              ;TRANSMIT IT
    2494/     CCA : CD 70 0C                    CALL CSHIGH             ;DESELECT
    2495/     CCD : CD 6B 0C                    CALL CSLOW              ;SELECT AGAIN
    2496/     CD0 : 3E 02                       MVI  A,EEWRDA           ;OPCODE WRITE DATA
    2497/     CD2 : CD 3C 0C                    CALL SDOUT              ;TRANSMIT IT
    2498/     CD5 : 78                          MOV  A,B                ;GET ADDRESS HIGH BYTE
    2499/     CD6 : CD 3C 0C                    CALL SDOUT              ;TRANSMIT
    2500/     CD9 : 79                          MOV  A,C                ;GET ADDRESS LOW BYTE
    2501/     CDA : CD 3C 0C                    CALL SDOUT              ;TRANSMIT
    2502/     CDD : 1B                  EEWR1:  DCX  D                  ;DECREMENT LENGTH
    2503/     CDE : (MACRO)                     JK   EEWR2              ;FINISH WHEN UNDERFLOW
    2503/     CDE : FD                          DB    0FDH
    2503/     CDF : EA                          DB    (EEWR2 & 0FFH)
    2503/     CE0 : 0C                          DB    (EEWR2 >> 8)
    2504/     CE1 : 7E                          MOV  A,M                ;FETCH FROM RAM
    2505/     CE2 : 23                          INX  H                  ;BUMP RAM POINTER
    2506/     CE3 : 03                          INX  B                  ;AND NEXT START ADDR
    2507/     CE4 : CD 3C 0C                    CALL SDOUT              ;TRANSMIT DATA
    2508/     CE7 : C3 DD 0C                    JMP  EEWR1              ;AND LOOP
    2509/     CEA : CD 70 0C            EEWR2:  CALL CSHIGH             ;END OF WRITE SESSION
    2510/     CED : C9                          RET
    2511/     CEE :                     ;
    2512/     CEE : C5                  EEWR:   PUSH B                  ;SAVE START ADDRESS
    2513/     CEF : E3                          XTHL                    ;SWAP WITH DATAPTR
    2514/     CF0 : 22 80 BF                    SHLD STKLMT+0           ;START ADDRESS @+0
    2515/     CF3 : EB                          XCHG                    ;SWAP TOT LEN TO (HL)
    2516/     CF4 : 22 82 BF                    SHLD STKLMT+2           ;TOT LENGTH @+2
    2517/     CF7 : E1                          POP  H                  ;GET DATAPTR BACK
    2518/     CF8 : 22 84 BF                    SHLD STKLMT+4           ;DATAPTR @+4
    2519/     CFB : EB                          XCHG                    ;SWAP BACK START ADR
    2520/     CFC : 11 40 00                    LXI  D,EEPGSZ           ;GET THE PAGE SIZE
    2521/     CFF : CD 52 07                    CALL DIVIDE             ;DIVIDE ADDR/PGSIZE
    2522/     D02 : EB                          XCHG                    ;REMAINDER TO (DE)
    2523/     D03 : 21 40 00                    LXI  H,EEPGSZ           ;GET THE PAGE SIZE
    2524/     D06 : CD 68 07                    CALL SUBDE              ;SUBTRACT PAGE OFFSET
    2525/     D09 : EB                          XCHG                    ;TO GET REMAINING MAX
    2526/     D0A : C3 10 0D                    JMP  EEW2               ;LENGTH OF FIRST PAGE
    2527/     D0D : 11 40 00            EEW1:   LXI  D,EEPGSZ           ;GET THE PAGE SIZE
    2528/     D10 : 2A 82 BF            EEW2:   LHLD STKLMT+2           ;GET TOT LENGTH
    2529/     D13 : E7                          RST  4                  ;COMPARE (HL - DE)
    2530/     D14 : D2 1C 0D                    JNC  EEW3               ;JMP IF (HL) >= (DE)
    2531/     D17 : 7C                          MOV  A,H                ;LESS THAN ONE PAGE
    2532/     D18 : B5                          ORA  L                  ;TO WRITE, SKIP
    2533/     D19 : C8                          RZ                      ;IF NOTHING AT ALL
    2534/     D1A : 54                          MOV  D,H                ;HAVE BYTES TO WRITE
    2535/     D1B : 5D                          MOV  E,L                ;PUT LENGTH IN (DE)
    2536/     D1C : CD 68 07            EEW3:   CALL SUBDE              ;SUB CHUNK LEN FROM TOT
    2537/     D1F : 22 82 BF                    SHLD STKLMT+2           ;SAVE REMAINING LENGTH
    2538/     D22 : 2A 80 BF                    LHLD STKLMT+0           ;GET ADDRESS
    2539/     D25 : 44                          MOV  B,H                ;AND TRANSFER
    2540/     D26 : 4D                          MOV  C,L                ;IT TO (BC)
    2541/     D27 : 2A 84 BF                    LHLD STKLMT+4           ;GET DATAPTR
    2542/     D2A : CD BA 0C                    CALL EEWRPG             ;WRITE THIS PAGE
    2543/     D2D : 22 84 BF                    SHLD STKLMT+4           ;SAVE UPDATED DATAPTR
    2544/     D30 : 60                          MOV  H,B                ;MOVE ADDRESS
    2545/     D31 : 69                          MOV  L,C                ;BACK TO (HL)
    2546/     D32 : 22 80 BF                    SHLD STKLMT+0           ;SAVE NEW ADDRESS
    2547/     D35 : C3 0D 0D                    JMP  EEW1               ;AND CONTINUE
    2548/     D38 :                     ;
