    1415/     722 : 4D                          MOV  C,L                ;REG BC
    1416/     723 : CD BD 07                    CALL SKPCOM             ;COMMA MAY SEPARATE ARGS
    1417/     726 : FF                          RST  7                  ;GET 5TH ARG WICH IS ACC
    1418/     727 : 7D                          MOV  A,L                ;MOVE ARG TO ITS POSITION
    1419/     728 : E1                          POP  H                  ;RETURN ARG(DE) TO HL
    1420/     729 : EB                          XCHG                    ;TXTPTR TO HL,(DE) TO DE
    1421/     72A : E3                          XTHL                    ;TXTPTR TO STK,(HL) TO HL
    1422/     72B : E5                  US2:    PUSH H                  ;SAVE (HL)ARG (OR DUMMY)
    1423/     72C : 21 36 07                    LXI  H,USRTN            ;FIND OUR RETURN ADDR
    1424/     72F : E3                          XTHL                    ;SWAP WITH ARG ON STACK
    1425/     730 : E5                          PUSH H                  ;SAVE ARGUMENT AGAIN
    1426/     731 : 2A 86 BF                    LHLD STKLMT+6           ;GET THE CALL ADDRESS
    1427/     734 : E3                          XTHL                    ;AGAIN SWAP WITH STACK
    1428/     735 : C9                          RET                     ;CALL BY PULL FROM STACK
    1429/     736 : D1                  USRTN:  POP  D                  ;RESTORE TEXT PTR
    1430/     737 : C9                          RET
    1431/     738 :                     ;
    1432/     738 : 21 1C 80            LEN:    LXI  H,TXTBGN           ;*** LEN ***
    1433/     73B : D5                          PUSH D                  ;GET THE NUMBER OF
    1434/     73C : EB                          XCHG                    ;BYTES BETWEEN 'TXTBGN'
    1435/     73D : 2A 1A 80                    LHLD TXTUNF             ;AND 'TXTUNF'
    1436/     740 : CD 68 07                    CALL SUBDE
    1437/     743 : D1                          POP  D
    1438/     744 : C9                          RET
    1439/     745 :                     ;
    1440/     745 : 2A 1A 80            FREE:   LHLD TXTUNF             ;*** FREE ***
    1441/     748 : D5                          PUSH D                  ;GET THE NUMBER OF FREE
    1442/     749 : EB                          XCHG                    ;BYTES BETWEEN 'TXTUNF'
    1443/     74A : 21 00 BF                    LXI  H,VARBGN           ;AND 'VARBGN'
    1444/     74D : CD 68 07                    CALL SUBDE
