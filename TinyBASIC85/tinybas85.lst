    1860/     921 :                     ;
    1861/     921 :                     ; *** PRTSTG *** QTSTG *** PRTNUM *** & PRTLN ***
    1862/     921 :                     ;
    1863/     921 :                     ; 'PRTSTG' PRINTS A STRING POINTED BY DE.  IT STOPS PRINTING
    1864/     921 :                     ; AND RETURNS TO CALLER WHEN EITHER A CR IS PRINTED OR WHEN
    1865/     921 :                     ; THE NEXT BYTE IS THE SAME AS WHAT WAS IN A (GIVEN BY THE
    1866/     921 :                     ; CALLER).  OLD A IS STORED IN B, OLD B IS LOST.
    1867/     921 :                     ;
    1868/     921 :                     ; 'QTSTG' LOOKS FOR A BACK-SLASH, SINGLE QUOTE, OR DOUBLE
    1869/     921 :                     ; QUOTE.  IF NONE OF THESE, RETURN TO CALLER.  IF BACK-SLASH,
    1870/     921 :                     ; OUTPUT ASCII OF FOLLOWING NUMBER. IF SINGLE OR DOUBLE QUOTE,
    1871/     921 :                     ; PRINT THE STRING IN THE QUOTE AND DEMAND A MATCHING UNQUOTE.
    1872/     921 :                     ; AFTER THE PRINTING THE NEXT 3 BYTES OF THE CALLER IS SKIPPED
    1873/     921 :                     ; OVER (USUALLY A JUMP INSTRUCTION.
    1874/     921 :                     ;
    1875/     921 :                     ; 'PRTNUM' PRINTS THE NUMBER IN HL.  LEADING BLANKS ARE ADDED
    1876/     921 :                     ; IF NEEDED TO PAD THE NUMBER OF SPACES TO THE NUMBER IN C.
    1877/     921 :                     ; HOWEVER, IF THE NUMBER OF DIGITS IS LARGER THAN THE # IN
    1878/     921 :                     ; C, ALL DIGITS ARE PRINTED ANYWAY.  NEGATIVE SIGN IS ALSO
    1879/     921 :                     ; PRINTED AND COUNTED IN, POSITIVE SIGN IS NOT.  IF REGISTER
    1880/     921 :                     ; C IS NEGATIVE, NUMBER IS PRINTED IN HEXADECIMAL.
    1881/     921 :                     ;
    1882/     921 :                     ; 'PRTLN' PRINTS A SAVED TEXT LINE WITH LINE # AND ALL.
    1883/     921 :                     ;
    1884/     921 : 47                  PRTSTG: MOV  B,A                ;*** PRTSTG ***
    1885/     922 : 1A                  PS1:    LDAX D                  ;GET A CHARACTER
    1886/     923 : 13                          INX  D                  ;BUMP POINTER
    1887/     924 : B8                          CMP  B                  ;SAME AS OLD A?
    1888/     925 : C8                          RZ                      ;YES, RETURN
    1889/     926 : D7                          RST  2                  ;ELSE PRINT IT
    1890/     927 : FE 0D                       CPI  CR                 ;WAS IT A CR?
    1891/     929 : C2 22 09                    JNZ  PS1                ;NO, NEXT
    1892/     92C : C9                          RET                     ;YES, RETURN
    1893/     92D :                     ;
    1894/     92D : CF                  QTSTG:  RST  1                  ;*** QTSTG ***
